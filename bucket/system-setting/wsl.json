{
  "version": "1.0.0",
  "description": "WSL",
  "url": "https://github.com/owenstake/owen-bucket/releases/download/v1.0.0/Empty.txt",
  "hash": "2E1CFA82B035C26CBBBDAE632CEA070514EB8B773F616AAEAF668E2F0BE8F10D",
  "depends" : ["wsl-dashboard"],
  "persist": ["systems"],
  "installer": {
    "script": [
      "''                                            ",
      "INFO 'Installing WSL'                         ",
      "wsl --install --no-distribution --pre-release ",
      "                                              ",
      "WARN 'Reboot is need for wsl to take effect!' "
    ]
  },
  "post_install": [
    "''                                                                         ",
    "# Use Junction. DefaultBasePath is useless, just ai illution.              ",
    "$jun = Join-Path $env:LOCALAPPDATA wsl                                     ",
    "$systemsDir = Join-Path $persist_dir $manifest.persist[0]                  ",
    "if (test-path $jun) {                                                      ",
    "  WARN ($jun + ' already exists, should manually fix/delete it !!')        ",
    "  exit 0                                                                   ",
    "}                                                                          ",
    "                                                                           ",
    "$null = New-Item -ItemType Junction -Path $jun -Target $systemsDir         ",
    "# New-Item -ItemType Junction -Path $jun -Target $systemsDir               ",
    "Write-Host ('Junction 创建成功: ' + $jun + ' -> ' + $systemsDir) -F Green  ",
    "                                                                           ",
    "# restore from persist                                                     ",
    "$registered = wsl -l -q 2>$null |                                          ",
    "  ForEach-Object { $_.Trim() } |                                           ",
    "  Where-Object { $_ -ne '' }                                               ",
    "                                                                           ",
    "$vhdxFiles = Get-ChildItem -Path $systemsDir -Recurse -Filter 'ext4.vhdx'  ",
    "                                                                           ",
    "foreach ($vhdx in $vhdxFiles) {                                            ",
    "  $name = $vhdx.Directory.Name                                             ",
    "                                                                           ",
    "  if ($name -match '^\\{[0-9a-f-]+\\}$') {                                 ",
    "    Write-Host ('发现 GUID 目录: ' + $name) -ForegroundColor Yellow        ",
    "    $name = Read-Host '请为该发行版指定一个名字（直接回车跳过）'           ",
    "    if ([string]::IsNullOrWhiteSpace($name)) {                             ",
    "      Write-Host '已跳过' -ForegroundColor Yellow                          ",
    "      continue                                                             ",
    "    }                                                                      ",
    "  }                                                                        ",
    "                                                                           ",
    "  if ($registered -contains $name) {                                       ",
    "    Write-Host ('跳过 ' + $name + '：已注册') -ForegroundColor Yellow      ",
    "    continue                                                               ",
    "  }                                                                        ",
    "                                                                           ",
    "  Write-Host ('正在导入 ' + $name + ' ...') -ForegroundColor Cyan          ",
    "  wsl --import-in-place $name $vhdx.FullName                               ",
    "                                                                           ",
    "  if ($LASTEXITCODE -eq 0) {                                               ",
    "    Write-Host ($name + ' 导入成功') -ForegroundColor Green                ",
    "    $registered += $name                                                   ",
    "  } else {                                                                 ",
    "    Write-Host ($name + ' 导入失败') -ForegroundColor Red                  ",
    "  }                                                                        ",
    "}                                                                          ",
    "                                                                           ",
    "''                                                                         ",
    "Write-Host '当前已注册的发行版：' -ForegroundColor Cyan                    ",
    "wsl -l -v                                                                  "
  ],
  "uninstaller": {
    "script": [
      "# $regPath = 'HKCU:/Software/Microsoft/Windows/CurrentVersion/Lxss' ",
      "# Remove-ItemProperty -Path $regPath -Name 'DefaultBasePath' -ea 0  ",
      "WARN 'You should uninstalling WSL Manully with wsl --uninstall '    ",
      "                                                                    ",
      "# wsl --uninstall                                                   ",
      "                                                                    ",
      "$j = Join-Path $env:localappdata wsl                                ",
      "if ( (test-path $j) -and (Get-Item $j).LinkTarget ) {               ",
      "  write-host Remove Junction $j -F green                            ",
      "  remove-item $j                                                    ",
      "} else {                                                            ",
      "  warn ($j + ' is not exists or not a junction.')                   ",
      "}                                                                   ",
    ]
  }
}
