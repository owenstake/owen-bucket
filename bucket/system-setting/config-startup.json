{
  "version": "1.0",
  "description": "Setup startup task for xdg autoload directory",
  "homepage": "https://github.com/owenstake/owen-bucket",
  "url": "https://github.com/owenstake/owen-bucket/releases/download/v1.0.0/Empty.txt",
  "hash": "2E1CFA82B035C26CBBBDAE632CEA070514EB8B773F616AAEAF668E2F0BE8F10D",
  "depends": [
    "xdg",
    "scoop-utils"
  ],
  "start_apps" : [
    "owen-keyboard",
    "qq",
    "v2rayN",
    "wechat",
    "weiyunsync",
    "wxwork"
  ],
  "psmodule": { "name": "default" },
  "pre_install" : [
    "''                                                         ",
    "if ($null -ne $manifest.files) {                           ",
    "  foreach ($prop in $manifest.files.psobject.Properties) { ",
    "    if ($prop.Name -like 'default.*') {                    ",
    "      $filename = $prop.Name -replace 'default',$app       ",
    "    } else {                                               ",
    "      $filename = $prop.Name                               ", 
    "    }                                                      ",
    "    $fullpath = Join-Path $dir $filename                   ",
    "    info ('Writing to ' + $fullpath)                       ",
    "    Set-Content -Path $fullpath -Value $prop.value         ",
    "  }                                                        ",
    "}                                                          "
  ],
  "installer": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') { ",
      "  $manifest.psmodule.name = $app             ",
      "}                                            "
    ]
  },
  "post_install": [
    "register_startup_hook                        ",
    "$apps = $manifest.start_apps                 ",
    "ForEach ($a in $apps) {                      ",
    "  Add-StartupForScoopApp($a)                 ",
    "}                                            "
  ],
  "uninstaller": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') { ",
      "  $manifest.psmodule.name = $app             ",
      "}                                            ",
      "                                             ",
      "Remove-AllStartupForScoopApp                 ",
      "unregister_startup_hook                      "
    ]
  },
  "files" : {
    "default.psm1" : [
      "$base_config_dir = if ($env:XDG_CONFIG_HOME) {                                  ",
      "    $env:XDG_CONFIG_HOME                                                        ",
      "  } else { $env:APPDATA }                                                       ",
      "$xdg_start_dir = Join-Path $base_config_dir 'autostart'                         ",
      "$scoopLnkDir = Join-Path ([Environment]::GetFolderPath('Programs')) 'Scoop Apps'",
      "                                                                                ",
      "Function Add-StartupForScoopApp($app) {                                         ",
      "  if ($lnkfile = Get-LnkForScoopApp $app) {                                     ",
      "    copy-item $lnkFile $xdg_start_dir/ -Force   -PassThru | ForEach-Object {    ",
      "      $_.LastWriteTime = $_.CreationTime = Get-Date                             ",
      "    }                                                                           ",
      "  } else {                                                                      ",
      "    write-host 'Skip it. No found shortcut in' $app                             ",
      "  }                                                                             ",
      "  return                                                                        ",
      "}                                                                               ",
      "                                                                                ",
      "Function Remove-StartupForScoopApp($app) {                                      ",
      "  Low cost invasion for host os. we are Parasitic system                        ",
      "  $j = $(scoop cat $app | ConvertFrom-Json )                                    ",
      "  $filename = $j.shortcuts[0][1] + '.lnk'                                       ",
      "  $lnkFile = Join-Path $xdg_start_dir $filename                                 ",
      "  if (!(Test-Path $lnkFile))  {                                                 ",
      "    Write-Error ('No Exists for ' + $lnkFile)                                   ",
      "    return -1                                                                   ",
      "  }                                                                             ",
      "}                                                                               ",
      "                                                                                ",
      "Function Remove-AllStartupForScoopApp($app) {                                   ",
      "  if ($xdg_start_dir) { Remove-Item -Path $xdg_start_dir/* -Force -Recurse }    ",
      "}                                                                               ",
      "                                                                                ",
      "function register_startup_hook() {                                              ",
      "  $startup_folder = [Environment]::GetFolderPath('Startup')                     ",
      "  $fullpath = Join-Path $PsScriptRoot 'run_xdg_autostart.cmd'                   ",
      "  copy-item $fullpath $startup_folder/ -v -Force                                ",
      "  Write-host 'register_startup_hook' -f green                                   ",
      "}                                                                               ",
      "                                                                                ",
      "function unregister_startup_hook() {                                            ",
      "  $startup_folder = [Environment]::GetFolderPath('Startup')                     ",
      "  $runner_script = Join-Path $startup_folder 'run_xdg_autostart.cmd'            ",
      "  if (Test-Path $runner_script) { Remove-Item $runner_script -Force }           ",
      "  Write-host 'unregister_startup_hook' -f green                                 ",
      "}                                                                               "
    ],
    "run_xdg_autostart.cmd" : [
      "<# : batch portion                                                           ",
      "@echo off                                                                    ",
      "powershell -NoProfile -ExecutionPolicy Bypass iex ((Get-Content '%~f0' -Raw))",
      "exit /b %errorlevel%                                                         ",
      ": end batch / begin PowerShell #>                                            ",
      "                                                                             ",
      "# 1. 動態計算自定義的 autostart 路徑                                         ",
      "$base_dir = if ($env:XDG_CONFIG_HOME) {                                      ",
      "  $env:XDG_CONFIG_HOME                                                       ",
      "} else { $env:APPDATA }                                                      ",
      "$xdg_start_dir = Join-Path $base_dir 'autostart'                             ",
      "                                                                             ",
      "# 2. 如果路徑存在，則遍歷所有檔案並非同步啟動                                ",
      "if (Test-Path $xdg_start_dir) {                                              ",
      "    Get-ChildItem $xdg_start_dir -File | ForEach-Object {                    ",
      "        try {                                                                ",
      "            # 使用 Start-Process 確保「非同步背景啟動」，程式才不會互相卡死  ",
      "            $filename = $_.FullName                                          ",
      "            Start-Process 'explorer.exe' -ArgumentList $filename             ",
      "        } catch {                                                            ",
      "            Write-Warning ('無法啟動: {0}' -f $_.Name)                       ",
      "        }                                                                    ",
      "    }                                                                        ",
      "}                                                                            ",
      "                                                                             ",
      "# 3. 保持視窗顯示（可選，若想完全隱藏可刪除此行）                            ",
      "Start-Sleep -Seconds 10                                                      "
    ]
  }
}
