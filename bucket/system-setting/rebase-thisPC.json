      "function Get-KnownFolderPath {                                                        ",
      "  <#                                                                                  ",
      "  .SYNOPSIS                                                                           ",
      "    获取已知文件夹的当前路径。                                                        ",
      "    默认返回注册表原文（不展开环境变量），加 -Expand 返回展开后的绝对路径。           ",
      "  .EXAMPLE                                                                            ",
      "    Get-KnownFolderPath -KnownFolder 'Desktop'                                        ",
      "    # 输出: %home%/Desktop                                                            ",
      "                                                                                      ",
      "    Get-KnownFolderPath -KnownFolder 'Desktop' -Expand                                ",
      "    # 输出: C:/Users/owen/Desktop                                                     ",
      "  #>                                                                                  ",
      "  [CmdletBinding()]                                                                   ",
      "  Param(                                                                              ",
      "    [Parameter(Mandatory = $true)]                                                    ",
      "    [ValidateSet(                                                                     ",
      "      'Desktop', 'Documents', 'Downloads', 'Music',                                   ",
      "      'Pictures', 'Videos', 'RoamingAppData', 'LocalAppData',                         ",
      "      'LocalAppDataLow', 'StartMenu', 'Programs', 'Startup',                          ",
      "      'Templates', 'Favorites', 'SendTo', 'Recent',                                   ",
      "      'Cookies', 'InternetCache', 'History', 'SavedGames',                            ",
      "      'Contacts', 'Links', 'SearchHome', 'Profile'                                    ",
      "    )]                                                                                ",
      "    [string]$KnownFolder,                                                             ",
      "                                                                                      ",
      "    [switch]$Expand                                                                   ",
      "  )                                                                                   ",
      "                                                                                      ",
      "  $regGuid = $script:GuidMap[$KnownFolder]                                            ",
      "  $rawPath = $null                                                                    ",
      "                                                                                      ",
      "  # 用 .NET API 读取，避免自动展开环境变量                                            ",
      "  $regKey = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey(                       ",
      "    'Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\User Shell Folders'      ",
      "  )                                                                                   ",
      "  if ($regKey) {                                                                      ",
      "    $rawPath = $regKey.GetValue(                                                      ",
      "      $regGuid, $null,                                                                ",
      "      [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames             ",
      "    )                                                                                 ",
      "    $regKey.Close()                                                                   ",
      "  }                                                                                   ",
      "                                                                                      ",
      "  # 注册表无自定义值时，回退获取默认路径                                              ",
      "  if (-not $rawPath) {                                                                ",
      "    if ($script:SpecialFolderMap.ContainsKey($KnownFolder)) {                         ",
      "      $rawPath = [Environment]::GetFolderPath($script:SpecialFolderMap[$KnownFolder]) ",
      "    } else {                                                                          ",
      "      switch ($KnownFolder) {                                                         ",
      "        'Downloads'       { $rawPath = Join-Path $env:USERPROFILE 'Downloads' }       ",
      "        'Contacts'        { $rawPath = Join-Path $env:USERPROFILE 'Contacts' }        ",
      "        'Links'           { $rawPath = Join-Path $env:USERPROFILE 'Links' }           ",
      "        'SavedGames'      { $rawPath = Join-Path $env:USERPROFILE 'Saved Games' }     ",
      "        'SearchHome'      { $rawPath = Join-Path $env:USERPROFILE 'Searches' }        ",
      "        'LocalAppDataLow' { $rawPath = Join-Path $env:USERPROFILE 'AppData/LocalLow' }",
      "        default           { $rawPath = '' }                                           ",
      "      }                                                                               ",
      "    }                                                                                 ",
      "  }                                                                                   ",
      "                                                                                      ",
      "  if ($Expand) {                                                                      ",
      "    return [Environment]::ExpandEnvironmentVariables($rawPath)                        ",
      "  }                                                                                   ",
      "  return $rawPath                                                                     ",
      "}                                                                                     ",
      "                                                                                            ",
      "function Get-AllKnownFolderPath {                                                           ",
      "  <#                                                                                        ",
      "  .SYNOPSIS                                                                                 ",
      "    列出所有已知文件夹的当前路径。                                                          ",
      "    默认返回注册表原文（不展开环境变量），加 -Expand 返回展开后的绝对路径。                 ",
      "  .EXAMPLE                                                                                  ",
      "    Get-AllKnownFolderPath                                                                  ",
      "    Get-AllKnownFolderPath -Expand                                                          ",
      "    Get-AllKnownFolderPath -OnlyRedirected                                                  ",
      "  #>                                                                                        ",
      "  [CmdletBinding()]                                                                         ",
      "  Param(                                                                                    ",
      "    [switch]$Expand,                                                                        ",
      "    [switch]$OnlyRedirected                                                                 ",
      "  )                                                                                         ",
      "                                                                                            ",
      "  $results = foreach ($name in $script:GuidMap.Keys | Sort-Object) {                        ",
      "    $guid = $script:GuidMap[$name]                                                          ",
      "                                                                                            ",
      "    # 优先从注册表读取原文（不展开环境变量）                                                ",
      "    write-host $name $guid                                                                  ",
      "    $rawPath = Get-RegRawValue -ValueName $guid                                             ",
      "                                                                                            ",
      "    # 注册表无自定义值时，回退获取默认路径                                                  ",
      "    if (-not $rawPath) {                                                                    ",
      "      if ($script:SpecialFolderMap.ContainsKey($name)) {                                    ",
      "        $rawPath = [Environment]::GetFolderPath($script:SpecialFolderMap[$name])            ",
      "      } else {                                                                              ",
      "        switch ($name) {                                                                    ",
      "          'Downloads'       { $rawPath = Join-Path $env:USERPROFILE 'Downloads' }           ",
      "          'Contacts'        { $rawPath = Join-Path $env:USERPROFILE 'Contacts' }            ",
      "          'Links'           { $rawPath = Join-Path $env:USERPROFILE 'Links' }               ",
      "          'SavedGames'      { $rawPath = Join-Path $env:USERPROFILE 'Saved Games' }         ",
      "          'SearchHome'      { $rawPath = Join-Path $env:USERPROFILE 'Searches' }            ",
      "          'LocalAppDataLow' { $rawPath = Join-Path $env:USERPROFILE 'AppData/LocalLow' }    ",
      "          default           { $rawPath = '' }                                               ",
      "        }                                                                                   ",
      "      }                                                                                     ",
      "    }                                                                                       ",
      "                                                                                            ",
      "    $expandedPath = [Environment]::ExpandEnvironmentVariables($rawPath)                     ",
      "    $isRedirected = $null -ne (Get-RegRawValue -ValueName $guid)                            ",
      "                                                                                            ",
      "    # 仅显示已重定向的条目                                                                  ",
      "    if ($OnlyRedirected -and -not $isRedirected) {                                          ",
      "      continue                                                                              ",
      "    }                                                                                       ",
      "                                                                                            ",
      "    [PSCustomObject]@{                                                                      ",
      "      Name         = $name                                                                  ",
      "      RawPath      = $rawPath                                                               ",
      "      ExpandedPath = $expandedPath                                                          ",
      "      Redirected   = $isRedirected                                                          ",
      "    }                                                                                       ",
      "  }                                                                                         ",
      "                                                                                            ",
      "  if ($Expand) {                                                                            ",
      "    $results | Select-Object Name, ExpandedPath, Redirected                                 ",
      "  } else {                                                                                  ",
      "    $results                                                                                ",
      "  }                                                                                         ",
      "}                                                                                           ",
      "                                                                                            ",
      "                                                                                            ",
      "function Set-KnownFolderPath {                                                              ",
      "  <#                                                                                        ",
      "  .SYNOPSIS                                                                                 ",
      "    重定向已知文件夹路径，注册表中保留环境变量原样存储。                                    ",
      "  .EXAMPLE                                                                                  ",
      "    Set-KnownFolderPath -KnownFolder 'Downloads' -Path '%home%/Downloads'                   ",
      "  .EXAMPLE                                                                                  ",
      "    Set-KnownFolderPath -KnownFolder 'Downloads' -Reset                                     ",
      "  .EXAMPLE                                                                                  ",
      "    Set-KnownFolderPath -Batch @{                                                           ",
      "      Desktop   = '%home%/Desktop'                                                          ",
      "      Documents = '%home%/Documents'                                                        ",
      "      Downloads = '%home%/Downloads'                                                        ",
      "    }                                                                                       ",
      "  #>                                                                                        ",
      "  [CmdletBinding()]                                                                         ",
      "  Param(                                                                                    ",
      "    [Parameter(Mandatory = $true, ParameterSetName = 'Single')]                             ",
      "    [Parameter(Mandatory = $true, ParameterSetName = 'Batch')]                              ",
      "    [ValidateSet(                                                                           ",
      "      'Desktop', 'Documents', 'Downloads', 'Music',                                         ",
      "      'Pictures', 'Videos', 'RoamingAppData', 'LocalAppData',                               ",
      "      'LocalAppDataLow', 'StartMenu', 'Programs', 'Startup',                                ",
      "      'Templates', 'Favorites', 'SendTo', 'Recent',                                         ",
      "      'Cookies', 'InternetCache', 'History', 'SavedGames',                                  ",
      "      'Contacts', 'Links', 'SearchHome', 'Profile'                                          ",
      "    )]                                                                                      ",
      "    [string]$KnownFolder,                                                                   ",
      "                                                                                            ",
      "    [Parameter(Mandatory = $true, ParameterSetName = 'Single')]                             ",
      "    [string]$Path,                                                                          ",
      "                                                                                            ",
      "    [Parameter(Mandatory = $true, ParameterSetName = 'Batch')]                              ",
      "    [hashtable]$Batch,                                                                      ",
      "                                                                                            ",
      "    [Parameter(ParameterSetName = 'Single')]                                                ",
      "    [switch]$Reset                                                                          ",
      "  )                                                                                         ",
      "                                                                                            ",
      "  # ---- 加载 P/Invoke 声明 ----                                                            ",
      "  $typeName = 'Win32.KnownFolders'                                                          ",
      "  if (-not ([System.Management.Automation.PSTypeName]$typeName).Type) {                     ",
      "    $Signature = @'                                                                         ",
      "using System;                                                                               ",
      "using System.Runtime.InteropServices;                                                       ",
      "                                                                                            ",
      "namespace Win32 {                                                                           ",
      "  public class KnownFolders {                                                               ",
      "    [DllImport(\"shell32.dll\", CharSet = CharSet.Unicode)]                                 ",
      "    public static extern int SHSetKnownFolderPath(                                          ",
      "      [In] ref Guid folderId,                                                               ",
      "      [In] uint dwFlags,                                                                    ",
      "      [In] IntPtr hToken,                                                                   ",
      "      [In] string pszPath                                                                   ",
      "    );                                                                                      ",
      "  }                                                                                         ",
      "}                                                                                           ",
      "'@                                                                                          ",
      "    Add-Type -TypeDefinition $Signature -PassThru | Out-Null                                ",
      "  }                                                                                         ",
      "                                                                                            ",
      "  # ---- 批量模式 ----                                                                      ",
      "  if ($PSCmdlet.ParameterSetName -eq 'Batch') {                                             ",
      "    foreach ($entry in $Batch.GetEnumerator()) {                                            ",
      "      Set-KnownFolderPath -KnownFolder $entry.Key -Path $entry.Value                        ",
      "    }                                                                                       ",
      "    return                                                                                  ",
      "  }                                                                                         ",
      "                                                                                            ",
      "  # ---- 重置模式 ----                                                                      ",
      "  if ($Reset) {                                                                             ",
      "    $regPath = 'HKCU:/Software/Microsoft/Windows/CurrentVersion/Explorer/User Shell Folders'",
      "    $regGuid = $script:GuidMap[$KnownFolder]                                                ",
      "                                                                                            ",
      "    Remove-ItemProperty -Path $regPath -Name $regGuid -ErrorAction SilentlyContinue         ",
      "    Write-Host ('[OK] {0} 已重置为系统默认路径' -f $KnownFolder) -ForegroundColor Cyan      ",
      "    return                                                                                  ",
      "  }                                                                                         ",
      "                                                                                            ",
      "  # ---- 验证目标路径 ----                                                                  ",
      "  $expandedPath = [Environment]::ExpandEnvironmentVariables($Path)                          ",
      "  if (-not (Test-Path $expandedPath -PathType Container)) {                                 ",
      "    New-Item -Path $expandedPath -ItemType Directory -Force | Out-Null                      ",
      "    Write-Host '  [INFO] 目标路径不存在，已自动创建: ' $expandedPath -F Yellow              ",
      "    return                                                                                  ",
      "  }                                                                                         ",
      "                                                                                            ",
      "  # ---- 调用 SHSetKnownFolderPath ----                                                     ",
      "  $guid = $script:GuidMap[$KnownFolder]                                                     ",
      "  $KF_FLAG_DONT_UNEXPAND = [uint32]0x00002000                                               ",
      "                                                                                            ",
      "  $result = [Win32.KnownFolders]::SHSetKnownFolderPath(                                     ",
      "    [ref]$guid, $KF_FLAG_DONT_UNEXPAND, [IntPtr]::Zero, $Path                               ",
      "  )                                                                                         ",
      "                                                                                            ",
      "  if ($result -ne 0) {                                                                      ",
      "    Write-Error ('SHSetKnownFolderPath 调用失败，返回值: 0x{0}' -f $result.ToString('X8'))  ",
      "    return                                                                                  ",
      "  }                                                                                         ",
      "                                                                                            ",
      "  # --- 动作 B: 条件性同步注册表 (存在才更新) ---                                           ",
      "  # Re-get guid , guid is trimed the curl brackets in ref                                   ",
      "  $guid = $script:GuidMap[$KnownFolder]                                                     ",
      "  # 1. 检查并更新 GUID 主键 (如果系统中存在)                                                ",
      "  $regPath = 'HKCU:/Software/Microsoft/Windows/CurrentVersion/Explorer/User Shell Folders'  ",
      "  write-host guid $guid                                                                     ",
      "  if ($null -ne (Get-ItemProperty -Path $RegPath -Name $guid -ea 0)) {                      ",
      "    Set-ItemProperty -Path $RegPath -Name $guid -Value $Path -Type ExpandString -Force      ",
      "      Write-Host ('  [Sync] GUID 键{0} 已更新' -f $guid) -F Green                           ",
      "  } else {                                                                                  ",
      "    Write-Host ('  [Skip] GUID 键{0} 不存在，跳过' -f $guid) -F Gray                        ",
      "  }                                                                                         ",
      "                                                                                            ",
      "  # 2. 检查并更新别名键 (如果系统中存在)                                                    ",
      "  # 直接使用 $alias 变量，它已经是 'My Pictures' 这样的字符串了                             ",
      "  $alias = $script:AliasMap[$KnownFolder]                                                   ",
      "  if ($alias) {                                                                             ",
      "    if ($null -ne (Get-ItemProperty -Path $RegPath -Name $alias -ea 0 )) {                  ",
      "      Set-ItemProperty -Path $RegPath -Name $alias -Value $Path -Type ExpandString -Force   ",
      "        Write-Host ('  [Sync] 别名 {0} 已更新' -f $alias) -F Green            ",
      "    } else {                                                                                ",
      "      Write-Host ('  [Skip] 别名 {0} 不存在，跳过' -f $alias) -F Gray         ",
      "    }                                                                                       ",
      "  }                                                                                         ",
      "                                                                                            ",
      "  Write-Host ('[OK] {0} 已成功重定向到 {1}' -f $KnownFolder, $Path) -F Green  ",
      "}                                                                                           ",
      "                                                                                            ",
      "                                                                                            ",
      "function Test-KnownFolderPath {                                                             ",
      "  <#                                                                                        ",
      "  .SYNOPSIS                                                                                 ",
      "    判断已知文件夹是否已被重定向（即注册表中是否存在自定义值）。                            ",
      "  .EXAMPLE                                                                                  ",
      "    Test-KnownFolderPath -KnownFolder 'Downloads'                                           ",
      "    Test-KnownFolderPath -KnownFolder 'Downloads' -Verbose                                  ",
      "  #>                                                                                        ",
      "  [CmdletBinding()]                                                                         ",
      "  Param(                                                                                    ",
      "    [Parameter(Mandatory = $true)]                                                          ",
      "    [ValidateSet(                                                                           ",
      "      'Desktop', 'Documents', 'Downloads', 'Music',                                         ",
      "      'Pictures', 'Videos', 'RoamingAppData', 'LocalAppData',                               ",
      "      'LocalAppDataLow', 'StartMenu', 'Programs', 'Startup',                                ",
      "      'Templates', 'Favorites', 'SendTo', 'Recent',                                         ",
      "      'Cookies', 'InternetCache', 'History', 'SavedGames',                                  ",
      "      'Contacts', 'Links', 'SearchHome', 'Profile'                                          ",
      "    )]                                                                                      ",
      "    [string]$KnownFolder                                                                    ",
      "  )                                                                                         ",
      "                                                                                            ",
      "  $regGuid = $script:GuidMap[$KnownFolder]                                                  ",
      "                                                                                            ",
      "  $rawValue = Get-RegRawValue -ValueName $regGuid                                           ",
      "  $isRedirected = $null -ne $rawValue                                                       ",
      "                                                                                            ",
      "  if ($isRedirected) {                                                                      ",
      "    Write-Verbose ('{0} 已重定向到: {1}' -f $KnownFolder, $rawValue)                        ",
      "  } else {                                                                                  ",
      "    Write-Verbose ('{0} 使用系统默认路径' -f $KnownFolder)                                  ",
      "  }                                                                                         ",
      "                                                                                            ",
      "  return [bool]$isRedirected                                                                ",
      "}                                                                                           "
    ]
  }
}
