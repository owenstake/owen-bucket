{
  "version": "1.0",
  "description": "Config right click menu with scoop apps",
  "homepage": "https://github.com/owenstake/owen-bucket",
  "depends": [
    "7zip",
    "ouch",
    "vim-tux",
    "draw.io",
    "foxit-pdf-reader-2023"
  ],
  "url": "https://github.com/owenstake/owen-bucket/releases/download/v1.0.0/Empty.txt",
  "hash": "2E1CFA82B035C26CBBBDAE632CEA070514EB8B773F616AAEAF668E2F0BE8F10D",
  "psmodule": { "name": "default" },
  "pre_install" : [
    "''                                                                  ",
    "if ($null -ne $manifest.files) {                                    ",
    "  foreach ($prop in $manifest.files.psobject.Properties) {          ",
    "    if ($prop.Name -like 'default.*') {                             ",
    "      $filename = $prop.Name -replace 'default',$app                ",
    "    } elseif ($prop.Name -like 'base64:*') {                        ",
    "      $filename = ($prop.Name -replace '^base64:', '')              ",
    "      $prop.Value = [Convert]::FromBase64String($prop.Value.trim()) ",
    "      $isBinary = $true                                             ", 
    "    } else {                                                        ",
    "      $filename = $prop.Name                                        ", 
    "    }                                                               ",
    "    $fullpath = Join-Path $dir $filename                            ",
    "    info ('Writing to ' + $fullpath)                                ",
    "    if ($isBinary) {                                                ",
    "      [System.IO.File]::WriteAllBytes($fullpath, $prop.Value)       ",
    "    } else {                                                        ",
    "      $prop.Value = $prop.Value -replace '(?m)\\s+$', ''            ",
    "      Set-Content -Path $fullpath -Value $prop.value                ",
    "    }                                                               ",
    "  }                                                                 ",
    "}                                                                   ",
    "                                                                    "
  ],
  "installer": {
    "script": [
      "''                                                                              ",
      "if ($manifest.psmodule.name -eq 'default') {                                    ",
      "  $manifest.psmodule.name = $app                                                ",
      "}                                                                               ",
      "                                                                                ",
      ". (Join-Path $dir 'common_script.ps1')                                          ",
      "# Get-ChildItem -Path $dir -Filter '*.b64' | ForEach-Object {                   ",
      "#   $params = @{                                                                ",
      "#     Base64FilePath = $_.FullName                                              ",
      "#     OutPath = ($_.FullName -replace '.b64$', '')                              ",
      "#   }                                                                           ",
      "#   Convert-Base64FileToFile @params                                            ",
      "# }                                                                             ",
      "                                                                                ",
      "INFO 'Set right click menu'                                                     ",
      "Add-RightClickScoopItemForAll 'vscode'                                          ",
      "Add-RightClickScoopItemForAll 'vim-tux'                                         ",
      "Add-RightClickScoopItemForAll '7zip'                                            ",
      "                                                                                ",
      "# Powershell.exe is better for debug than cmd.exe                               ",
      "                                                                                ",
      "$drawioExe = Join-Path (scoop prefix draw.io) 'draw.io.exe'                     ",
      "$cmd = '{0}{1}{0} {0}%1{0}' -f [char]34,$drawioExe                              ",
      "$params = @(                                                                    ",
      "  '.svg,.png,.drawio',                                                          ",
      "  'Edit-By-Drawio',                                                             ",
      "  $drawioExe,                                                                   ",
      "  $cmd                                                                          ",
      ")                                                                               ",
      "Add-RightClickItemWithCommand @params                                           ",
      "                                                                                ",
      "$cmd = 'powershell -c {0}Paste-FileAsShortcut {0}%W{0} {0}' -f [char]34         ",
      "$params = @(                                                                    ",
      "  'Directory/Background'                                                        ",
      "  '粘贴快捷方式(环境变量)'                                                      ",
      "  '%SystemRoot%/system32/shell32.dll,-16769'                                    ",
      "  $cmd                                                                          ",
      ")                                                                               ",
      "Add-RightClickItemWithCommand @params                                           ",
      "                                                                                ",
      "$cmd = 'cmd /c singleinstance.exe {0}%1{0} powershell -noprofile -c ' +         ",
      "          '{0} . {1}; Compress-Interactive $files {0} --si-timeout 400'         ",
      "$filepath = Join-Path $dir 'runtime_script.ps1'                                 ",
      "$cmd = $cmd -f [char]34,$filepath                                               ",
      "$params = @(                                                                    ",
      "  'AllFileSystemObjects'                                                        ",
      "  'Zip'                                                                         ",
      "  '%SystemRoot%/System32/zipfldr.dll'                                           ",
      "  $cmd                                                                          ",
      ")                                                                               ",
      "Add-RightClickItemWithCommand @params                                           ",
      "                                                                                ",
      "$cmd = 'powershell -c {0}ouch decompress {0}%1{0} {0}' -f [char]34              ",
      "$params = @(                                                                    ",
      "  '.7z,.rar,.zip,.tgz,.gz,.xz'                                                  ",
      "  'Expand'                                                                      ",
      "  '%SystemRoot%/System32/zipfldr.dll'                                           ",
      "  $cmd                                                                          ",
      ")                                                                               ",
      "Add-RightClickItemWithCommand @params                                           ",
      "                                                                                ",
      "$FoxitExe = Join-Path (scoop prefix foxit-pdf-reader-2023) 'FoxitPDFReader.exe' ",
      "$cmd = '{0}{1}{0} {0}%1{0}' -f [char]34,$FoxitExe                               ",
      "$params = @(                                                                    ",
      "  '.pdf'                                                                        ",
      "  'Open-By-Foxit'                                                               ",
      "  $FoxitExe                                                                     ",
      "  $cmd                                                                          ",
      ")                                                                               ",
      "Add-RightClickItemWithCommand @params                                           ",
      "                                                                                ",
      "$XmindExe = Join-Path (scoop prefix xmind) 'xmind.exe'                          ",
      "$cmd = '{0}{1}{0} {0}%1{0}' -f [char]34,$XmindExe                               ",
      "$params = @(                                                                    ",
      "  '.xmind'                                                                      ",
      "  'Open-By-Xmind'                                                               ",
      "  $XmindExe                                                                     ",
      "  $cmd                                                                          ",
      ")                                                                               ",
      "Add-RightClickItemWithCommand @params                                           ",
      "                                                                                ",
      "INFO 'Add new file item'                                                        ",
      "$drawioFile    = (Get-ChildItem $dir -R 'blank.drawio'    )[0].FullName         ",
      "$drawioPngFile = (Get-ChildItem $dir -R 'blank.drawio.png')[0].FullName         ",
      "$drawioSvgFile = (Get-ChildItem $dir -R 'blank.drawio.svg')[0].FullName         ",
      "                                                                                ",
      "Add-ShellNewWithTemplate $drawioPngFile                                         ",
      "Add-ShellNewWithTemplate $drawioSvgFile                                         ",
      "# Add-ShellNewWithTemplate $drawioFile                                          ",
      "                                                                                "
    ]
  },
  "uninstaller": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') {       ",
      "  $manifest.psmodule.name = $app                   ",
      "}                                                  ",
      "                                                   ",
      ". (Join-Path $dir 'common_script.ps1')             ",
      "Remove-RightClickMenu                              "
    ]
  },
  "files" : {
    "default.psm1" : [
      " "
    ],
    "runtime_script.ps1" : [
      "Function Compress-Interactive() {                                                 ",
      "  $files = $args                                                                  ",
      "  if($files.count -eq 0) {                                                        ",
      "    Write-Error 'ERRO: No files to be compressed !'                               ",
      "    pause                                                                         ",
      "    return                                                                        ",
      "  }                                                                               ",
      "  $desDir = $(Get-Item $args[0]).Parent                                           ",
      "  if($files.count -eq 1) {                                                        ",
      "    # Only 1 file, use file name as zip name                                      ",
      "    $defaultZipName = $(Get-Item $files[0]).Basename                              ",
      "  } else {                                                                        ",
      "    # Multi file, use dir name as zip name                                        ",
      "    # $zipNameList = @()                                                          ",
      "    $defaultZipName = $desDir.Basename                                            ",
      "  }                                                                               ",
      "  if (!($defaultZipName.EndsWith('.zip'))) {      # add suffix .zip               ",
      "    $defaultZipName = $defaultZipName + '.zip'                                    ",
      "  }                                                                               ",
      "  [System.Windows.Forms.SendKeys]::SendWait($defaultZipName + '{Left}' * 4)       ",
      "  $zipName = Read-Host 'INFO: Enter zip name'                                     ",
      "  Write-Host 'INFO: DestinationPath is ' $zipName                                 ",
      "  If (Test-Path $zipName) {                                                       ",
      "    $defaultAns = 'y'                                                             ",
      "    $ans = Read-Host 'Info: {0} is already exists. Replace it? [Y/n]' -f $zipname ",
      "    if(!$ans) {$ans = $defaultAns}                                                ",
      "    if ($ans -eq 'y') {                                                           ",
      "      rm $zipName                                                                 ",
      "    } else {                                                                      ",
      "      Write-Error 'ERRO: Exit'                                                    ",
      "      pause                                                                       ",
      "      return                                                                      ",
      "    }                                                                             ",
      "  }                                                                               ",
      "  If (Get-Command ouch.exe -ea 0) {                                               ",
      "    Ouch compress $files $zipName                                                 ",
      "  } elseif (Get-Command 7z.exe -ea 0) {  # 7z.exe is faster ?                     ",
      "    7z.exe a $zipName $files                                                      ",
      "  } else {                                                                        ",
      "    Compress-Archive $files -DestinationPath $zipName                             ",
      "  }                                                                               ",
      "  Write-Host ('INFO: Compress {0} to {1}' -f $files,$zipName)                     ",
      "  pause                                                                           ",
      "  return                                                                          ",
      "}                                                                                 "
    ],
    "common_script.ps1" : [
      "function Set-ShellNewData {                                                         ",
      "  [CmdletBinding()]                                                                 ",
      "  param(                                                                            ",
      "    [Parameter(Mandatory=$true)]                                                    ",
      "    [ValidateScript({ Test-Path $_ -PathType Leaf })]                               ",
      "    [string]$FilePath,                                                              ",
      "                                                                                    ",
      "    [Parameter(Mandatory=$true)]                                                    ",
      "    [string]$Extension                                                              ",
      "  )                                                                                 ",
      "  process {                                                                         ",
      "    try {                                                                           ",
      "      # 1. 读取文件的所有字节                                                       ",
      "      $bytes = [System.IO.File]::ReadAllBytes($FilePath)                            ",
      "                                                                                    ",
      "      # 2. 构建当前用户级别的 ShellNew 注册表路径                                   ",
      "      $regPath = 'HKCU:/SOFTWARE/Classes/{0}/ShellNew' -f $Extension                ",
      "                                                                                    ",
      "      # 3. 检查并创建 ShellNew 项（如果不存在）                                     ",
      "      if (-not (Test-Path $regPath)) {                                              ",
      "        New-Item -Path $regPath -Force | Out-Null                                   ",
      "      }                                                                             ",
      "                                                                                    ",
      "      # 4. 将字节数组强制写入 Data 值                                               ",
      "      Set-ItemProperty -Path $regPath -Name 'Data' -Value ([byte[]]$bytes) -Force   ",
      "                                                                                    ",
      "      # 5. 输出成功日志                                                             ",
      "      Write-Host ('✅ 成功将 {0} 字节写入 [{1}] 的 Data 值'    `                    ",
      "                   -f $bytes.Length, $Extension) -F Green                           ",
      "    } catch {                                                                       ",
      "      Write-Error ('❌ 转换或写入失败: {0}' -f $_)                                  ",
      "    }                                                                               ",
      "  }                                                                                 ",
      "}                                                                                   ",
      "                                                                                    ",
      "function Convert-FileToBase64 {                                                     ",
      "  [CmdletBinding()]                                                                 ",
      "  param(                                                                            ",
      "    [Parameter(Mandatory=$true, ValueFromPipeline=$true,                            ",
      "                 ValueFromPipelineByPropertyName=$true)]                            ",
      "    [Alias('FullName')]                                                             ",
      "    [ValidateScript({ Test-Path $_ -PathType Leaf })]                               ",
      "    [string]$Path                                                                   ",
      "  )                                                                                 ",
      "  process {                                                                         ",
      "    try {                                                                           ",
      "      $resolvedPath = (Resolve-Path $Path).Path                                     ",
      "      $bytes = [System.IO.File]::ReadAllBytes($resolvedPath)                        ",
      "      $rawBase64 = [System.Convert]::ToBase64String($bytes)                         ",
      "                                                                                    ",
      "      # 使用正则表达式，每 70 个字符插入一个 CRLF 换行符                            ",
      "      return [regex]::Replace($rawBase64, '(.{70})', '$1'+[Environment]::NewLine)   ",
      "    } catch {                                                                       ",
      "      Write-Error ('转换失败: {0}' -f $_)                                           ",
      "    }                                                                               ",
      "  }                                                                                 ",
      "}                                                                                   ",
      "                                                                                    ",
      "function Convert-Base64ToFile {                                                     ",
      "  [CmdletBinding()]                                                                 ",
      "  param(                                                                            ",
      "    [Parameter(Mandatory=$true, ValueFromPipeline=$true)]                           ",
      "    [string]$Base64String,                                                          ",
      "                                                                                    ",
      "    [Parameter(Mandatory=$true)]                                                    ",
      "    [string]$DestinationPath                                                        ",
      "  )                                                                                 ",
      "  process {                                                                         ",
      "    try {                                                                           ",
      "      $bytes = [System.Convert]::FromBase64String($Base64String.Trim())             ",
      "      [System.IO.File]::WriteAllBytes($DestinationPath, $bytes)                     ",
      "      Write-Host ('✅ 文件已成功还原至: {0}' -f $DestinationPath) -F Green          ",
      "    } catch {                                                                       ",
      "      Write-Error ('还原失败: {0}' -f $_)                                           ",
      "    }                                                                               ",
      "  }                                                                                 ",
      "}                                                                                   ",
      "                                                                                    ",
      "Function GetExeForScoop($app) {                                                     ",
      "  $m = $(scoop cat $app | ConvertFrom-Json)                                         ",
      "  if ($m.'architecture'.'64bit'.'bin') {                                            ",
      "    $exe = $m.'architecture'.'64bit'.'bin'[0]                                       ",
      "  } elseif ($m.'shortcuts') {                                                       ",
      "    $exe = $m.'shortcuts'[0][0]                                                     ",
      "  } elseif ($m.'bin') {                                                             ",
      "    $exe = $m.'bin'[0]                                                              ",
      "  } else {                                                                          ",
      "    Write-Host 'No found exe for' $app                                              ",
      "      return $null                                                                  ",
      "  }                                                                                 ",
      "  return $exe                                                                       ",
      "}                                                                                   ",
      "                                                                                    ",
      "Function Add-RightClickItemWithCommand($node='AllFileSystemObjects',                ",
      "                                            $itemName, $icon='', $cmd) {            ",
      "  $scoopItemName = 'scoop-' + $itemName                                             ",
      "  $MuiVerb = $itemName                                                              ",
      "  $extList = @()                                                                    ",
      "  $prefix = 'HKCU:/Software/Classes'                                                ",
      "  $isSet = $false                                                                   ",
      "  $apply = ''                                                                       ",
      "                                                                                    ",
      "  Foreach ($n in $($node -split ',')) {                                             ",
      "    if ($n.StartsWith('.')) {                                                       ",
      "      $extList += $n.Substring(1)                                                   ",
      "      $n = 'AllFileSystemObjects'                                                   ",
      "      if ($isSet) {                                                                 ",
      "        continue                                                                    ",
      "      } else {                                                                      ",
      "        $isSet = $true                                                              ",
      "      }                                                                             ",
      "    }                                                                               ",
      "    $targetPath = '{0}/{1}/shell/{2}' -f $prefix,$n,$scoopItemName                  ",
      "    if (!(Test-Path $targetPath)) { New-Item $targetPath -Force | Out-Null }        ",
      "                                                                                    ",
      "    $cleanIcon = $icon.Trim([char]34)                                               ",
      "    $cleanIcon = '{0}{1}{0}' -f [char]34,$cleanIcon                                 ",
      "    Set-ItemProperty -Path $targetPath -Name 'icon' -Value $cleanIcon               ",
      "    Set-ItemProperty -Path $targetPath -Name 'MuiVerb' -Value $MuiVerb              ",
      "                                                                                    ",
      "    $cmdPath = $targetPath + '/command'                                             ",
      "    if (!(Test-Path $cmdPath)) { New-Item $cmdPath -Force | Out-Null }              ",
      "    Set-ItemProperty -Path $cmdPath -Name '(Default)' -Value $cmd                   ",
      "  }                                                                                 ",
      "                                                                                    ",
      "  if ($extList.Count) {                                                             ",
      "    $exts = $extList -Join ' OR '                                                   ",
      "    $apply = 'System.FileExtension: ({0})' -f $exts                                 ",
      "    $path = $prefix + '/AllFileSystemObjects/shell/' + $scoopItemName               ",
      "    Set-ItemProperty -Path $path -Name 'AppliesTo' -Value $apply                    ",
      "  }                                                                                 ",
      "}                                                                                   ",
      "                                                                                    ",
      "Function Add-RightClickItemInScoopTools($extension, $itemName, $exe, $param='%1') { ",
      "  $prefix = 'HKCU:/Software/Classes/{0}/Shell/scoop-tools' -f $extension            ",
      "  if (!(Test-Path $prefix)) { New-Item $prefix -Force | Out-Null }                  ",
      "  Set-ItemProperty -Path $prefix -Name 'SubCommands' -Value ''                      ",
      "  $v = Join-Path $dir 'scoop.ico'                                                   ",
      "  Set-ItemProperty -Path $prefix -Name 'icon' -Value $v                             ",
      "                                                                                    ",
      "  $itemPath = $prefix + '/shell/' + $itemName                                       ",
      "  if (!(Test-Path $itemPath)) { New-Item $itemPath -Force | Out-Null }              ",
      "                                                                                    ",
      "  $iconPath = '{0}{1}{0}' -f [char]34,$exe                                          ",
      "  Set-ItemProperty -Path $itemPath -Name 'icon' -Value $iconPath                    ",
      "                                                                                    ",
      "  $cmdItemPath = $itemPath + '/command'                                             ",
      "  if (!(Test-Path $cmdItemPath)) { New-Item $cmdItemPath -Force | Out-Null }        ",
      "  $cmd = '{0}{1}{0} {0}{2}{0}' -f [char]34,$exe,$param                              ",
      "  Set-ItemProperty -Path $cmdItemPath -Name '(Default)' -Value $cmd                 ",
      "}                                                                                   ",
      "                                                                                    ",
      "Function Add-RightClickScoopItem($extension, $scoopAppName,$exeName,$param='%1') {  ",
      "  $itemName = 'Open with & {0}' -f $scoopAppName                                    ",
      "  $exePath = Join-Path (scoop prefix $scoopAppName) $exeName                        ",
      "  Add-RightClickItemInScoopTools $extension $itemName $exePath  $param              ",
      "}                                                                                   ",
      "                                                                                    ",
      "Function Add-RightClickScoopItemForAll($scoopAppName, $param='%1') {                ",
      "  $exeName = $(GetExeForScoop $scoopAppName)                                        ",
      "  if ($exeName) {                                                                   ",
      "    Add-RightClickScoopItem 'AllFileSystemObjects' $scoopAppName $exeName '%1'      ",
      "    Add-RightClickScoopItem 'Directory/Background' $scoopAppName $exeName '%V'      ",
      "  }                                                                                 ",
      "}                                                                                   ",
      "                                                                                    ",
      "Function Add-ShellNewWithTemplate($filePath) {                                      ",
      "  if (!(Test-Path $filePath)) {                                                     ",
      "    Write-Error ('File not found! ' + $filePath)                                    ",
      "      return                                                                        ",
      "  }                                                                                 ",
      "  $extension = (Get-Item $filePath).Extension                                       ",
      "  $targetPath = 'HKCU:/Software/Classes/{0}/ShellNew' -f $extension                 ",
      "  if (!(Test-Path $targetPath)) { New-Item $targetPath -Force | Out-Null }          ",
      "                                                                                    ",
      "  # Set-ItemProperty -Path $targetPath -Name 'FileName' -Value $filePath            ",
      "  $bytes = [System.IO.File]::ReadAllBytes($filePath)                                ",
      "  Set-ItemProperty -Path $targetPath -Name 'Data' -Value ([byte[]]$bytes) -Force    ",
      "  Write-Host ('✅ 成功将 {0} 字节写入 [{1}] 的 Data 值' -f $bytes.Length,`          ",
      "               $Extension) -F Green                                                 ",
      "}                                                                                   ",
      "                                                                                    ",
      "Function Remove-RightClickMenu() {                                                  ",
      "  if (Test-Path 'HKCU:/Software/Classes/AllFileSystemObjects/Shell') {              ",
      "    Get-ChildItem -Path 'HKCU:/Software/Classes/AllFileSystemObjects/Shell' -ea 0 | ",
      "      Where-Object { $_.PSChildName -like 'scoop*' } |                              ",
      "      ForEach-Object { Remove-Item -Path $_.PSPath -Recurse -Force -ea 0}           ",
      "  }                                                                                 ",
      "                                                                                    ",
      "  if (Test-Path 'HKCU:/Software/Classes/Directory/Shell') {                         ",
      "    Get-ChildItem -Path 'HKCU:/Software/Classes/Directory/Shell' -ea 0 |            ",
      "      Where-Object { $_.PSChildName -like 'scoop*' } |                              ",
      "      ForEach-Object { Remove-Item -Path $_.PSPath -Recurse -Force -ea 0 }          ",
      "  }                                                                                 ",
      "                                                                                    ",
      "  if (Test-Path 'HKCU:/Software/Classes/Directory/Background/Shell') {              ",
      "    Get-ChildItem -Path 'HKCU:/Software/Classes/Directory/Background/Shell' -ea 0 | ",
      "      Where-Object { $_.PSChildName -like 'scoop*' } |                              ",
      "      ForEach-Object { Remove-Item -Path $_.PSPath -Recurse -Force -ea 0 }          ",
      "  }                                                                                 ",
      "}                                                                                   "
    ],
