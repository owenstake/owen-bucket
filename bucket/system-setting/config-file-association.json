{
  "version": "1.0",
  "description": "Config file assocation with scoop apps",
  "homepage": "https://github.com/owenstake/owen-bucket",
  "depends": [
    "7zip",
    "autohotkey1.1",
    "draw.io",
    "foxit-pdf-reader-2023",
    "typora-1.9.5",
    "vlc"
  ],
  "url": "https://github.com/owenstake/owen-bucket/releases/download/v1.0.0/Empty.txt",
  "hash": "2E1CFA82B035C26CBBBDAE632CEA070514EB8B773F616AAEAF668E2F0BE8F10D",
  "installer": {
    "script": [
      "''                                                                          ",
      "Invoke-Expression ($manifest.common_script -join [Environment]::NewLine)    ",
      "Associate-ScoopAppWithExtension '.ahk' 'autohotkey1.1'                      ",
      "Associate-ScoopAppWithExtension '.md' 'typora-1.9.5'                        ",
      "Associate-ScoopAppWithExtension '.pdf' 'foxit-pdf-reader-2023'              ",
      "Associate-ScoopAppWithExtension '.drawio,.png,.svg' 'draw.io'               ",
      "Associate-ScoopAppWithExtension '.mp4,mkv' 'vlc'                            ",
      "$7zFileType = '.7z,.rar,.zip,.tgz,.gz,.xz'                                  ",
      "$icon = '%SystemRoot%/System32/zipfldr.dll'                                 ",
      "Associate-ScoopAppWithExtension $7zFileType '7zip' $null $icon              "
    ]
  },
  "uninstaller": {
    "script": [
      "Invoke-Expression ($manifest.common_script -join [Environment]::NewLine) ",
      "Remove-AllFileAssociation                                                "
    ]
  },
  "common_script" : [
    "Function GetExeForScoop($app) {                                                       ",
    "  $m = $(scoop cat $app | ConvertFrom-Json)                                           ",
    "  if ($m.'architecture'.'64bit'.'bin') {                                              ",
    "    $exe = $m.'architecture'.'64bit'.'bin'[0]                                         ",
    "  } elseif ($m.'shortcuts') {                                                         ",
    "    $exe = $m.'shortcuts'[0][0]                                                       ",
    "  } elseif ($m.'bin') {                                                               ",
    "    $exe = $m.'bin'[0]                                                                ",
    "  } else {                                                                            ",
    "    return $null                                                                      ",
    "  }                                                                                   ",
    "  return $exe                                                                         ",
    "}                                                                                     ",
    "                                                                                      ",
    "Function Touch-ProgIdWtihExtention($appRegName, $exe, $extension, $icon=$null) {      ",
    "  $appRegPath = 'HKCU:/Software/Classes/' + $appRegName                               ",
    "  $cmdPath = $appRegPath + '/shell/open/command'                                      ",
    "  $iconRegPath = $appRegPath + '/DefaultIcon'                                         ",
    "  if (!(Test-Path $cmdPath)) { New-Item $cmdPath -Force | Out-Null }                  ",
    "  $cleanExe = $exe.Trim([char]34)                                                     ",
    "  $v = '{0}{1}{0} {0}%1{0}' -f [char]34,$cleanExe                                     ",
    "  Set-ItemProperty -Path $cmdPath -Name '(Default)' -Value $v                         ",
    "  $extPath = '{0}/extensions-associated/{1}' -f $appRegPath,$extension                ",
    "  if (!(Test-Path $extPath)) { New-Item $extPath -Force | Out-Null }                  ",
    "  Set-ItemProperty -Path $extPath -Name '(Default)' -Value '' -Type String            ",
    "                                                                                      ",
    "  # Set DefaultIcon                                                                   ",
    "  if (!(Test-Path $iconRegPath)) { New-Item $iconRegPath -Force | Out-Null }          ",
    "  if (!($icon)) { $icon = $cleanExe }                                                 ",
    "  Set-ItemProperty -Path $iconRegPath -Name '(Default)' -Value $icon -Type String     ",
    "                                                                                      ",
    "  # set content for shell new file                                                    ",
    "  Set-ItemProperty -Path $appRegPath -Name '(Default)' -Value $appRegName             ",
    "}                                                                                     ",
    "                                                                                      ",
    "Function Associate-ScoopAppWithExtension($extensions, $scoopAppName, $exeName=$null,  ",
    "                                     $icon=$null) {                                   ",
    "  if (!($exeName)) { $exeName = $(GetExeForScoop $scoopAppName) }                     ",
    "  Foreach ($e in $($extensions -split ',')) {                                         ",
    "    $appRegName = 'scoop.' + $scoopAppName + $e                                       ",
    "    $prefixPath = $(scoop prefix $scoopAppName)                                       ",
    "    Touch-ProgIdWtihExtention $appRegName ($prefixPath+'/'+$exeName) $e $icon         ",
    "    $openWithPath = 'HKCU:/Software/Classes/{0}/OpenWithProgids' -f $e                ",
    "    if (!(Test-Path $openWithPath)) { New-Item $openWithPath -Force | Out-Null }      ",
    "    Set-ItemProperty -Path $openWithPath -Name $appRegName -Value '' -Type String     ",
    "                                                                                      ",
    "    $extRegPath = 'HKCU:/Software/Classes/' + $e                                      ",
    "    Set-ItemProperty -Path $extRegPath -Name '(Default)' -Value $appRegName -Force    ",
    "  }                                                                                   ",
    "}                                                                                     ",
    "                                                                                      ",
    "Function Remove-AllFileAssociation() {                                                ",
    "  if (Test-Path 'HKCU:/Software/Classes') {                                           ",
    "    $regNames = Get-ChildItem -Path 'HKCU:/Software/Classes' -ea 0 |                  ",
    "          Where-Object { $_.PSChildName -like 'scoop.*' } |                           ",
    "          ForEach-Object { $_.PSChildName }                                           ",
    "                                                                                      ",
    "    Foreach ($r in $regNames) {                                                       ",
    "      $extPath = 'HKCU:/Software/Classes/{0}/extensions-associated' -f $r             ",
    "      if (Test-Path $extPath) {                                                       ",
    "        $extensions = Get-ChildItem -Path $extPath | ForEach-Object { $_.PSChildName }",
    "        Foreach ($e in $extensions) {                                                 ",
    "          $progIdPath = 'HKCU:/Software/Classes/{0}/OpenWithProgids' -f $e            ",
    "          if (Test-Path $progIdPath) {                                                ",
    "            Remove-ItemProperty -Path $progIdPath -Name $r -ea 0                      ",
    "          }                                                                           ",
    "        }                                                                             ",
    "      }                                                                               ",
    "      Remove-Item -Path ('HKCU:/Software/Classes/' + $r) -Recurse -Force -ea 0        ",
    "    }                                                                                 ",
    "  }                                                                                   ",
    "}                                                                                     "
  ],
}
