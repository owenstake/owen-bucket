{
  "version": "1.0",
  "description": "Owen setup system for all.",
  "homepage": "https://github.com/owenstake/owen-bucket",
  "url": "https://github.com/owenstake/owen-bucket/releases/download/v1.0.0/Empty.txt",
  "hash" : "2E1CFA82B035C26CBBBDAE632CEA070514EB8B773F616AAEAF668E2F0BE8F10D",
  "depends": [ "7zip", "git", "powershell" ],
  "apps_matrix": [
    // Install first
    "scoop-enhacne", "owen-install-buckets", 

    // owen system setting . No depends first
    "xdg", "config-explorer",
    "config-startup", "config-right-click-menu", "config-file-association",
    "config-right-click-menu-expansion", "config-realtime-protection",

    // basic for scoop
    "7zip", "git", "autohotkey1.1", "v2rayN", "vscode",  // "vim-tux", 

    // System config
    "ms-shuangpin",  // "owen-system-setting",

    // CLI basic tool
    "gsudo", "sudo", "less", "bat", "tre-command", "iconv",         
    "recycle-bin", "file", "single-instance",

    // CLI program tool
    "global", "go", "lua", "nodejs-lts", "python", "rust", "winget", "mingw",
    "neovim", "openjdk",

    // CLI super tool
    "eza", "fd", "ripgrep", "fzf", "psfzf", 
    "psreadline", "chafa", "psmux", "powershell", "latex",

    // font
    "CascadiaCode-NF",       // "SarasaGothic-SC",     

    // Cli super tool in rust
    "bandwhich", "bottom", "delta", "difftastic", "dust",
    "fselect", "grex", "hexyl", "hyperfine", "lsd",
    "macchina", "ouch", "procs", "sd", "starship",
    "tealdeer", "tokei", "watchexec", "zoxide",

    "ffmpeg",

    // UI simple tool
    "Snipaste", "ScreenToGif", "Flux", "Everything",

    // UI system tool
    "Regscanner",

    // UI super tool
    "Draw.io", "wezterm-nightly", "windows-terminal-preview", "f.lux",
    "sumatraPDF", "wegame",

    // UI app
    "BaiduNetdisk", "Firefox", "Foxit-pdf-reader-2023", "Foxmail", "googlechrome",
    "HeidiSQL", "i4", "Mobaxterm", "Motrix", "typora-1.9.5", "Q-dir", "Wechat",
    "wxwork", "obsidian", "Thunder", "ThunderVideo", "Tor-browser",
    "vagrant", "vlc", "qq-nt", "xmind", "zotero", "quarkpan",

    // owen custom ui app
    "owen-bucket/kuwo", "owen-bucket/360DrvMgr", "weiyunsync",

    // owen app config
    "owen-chrome", "owen-firefox", "owen-typora", "owen-v2rayN",
    "owen-windows-terminal-preview",

    // Final
    "scoop-completion",
  ],
  "installer": {
    "script": [
      "''                                                                                        ",
      "WARN 'Use powershell 7 !!!!'                                                              ",
      "$installed = (scoop list).name + $app                                                     ",
      "$targetApps = $manifest.depends + $manifest.apps_matrix + $app                            ",
      "                                                                                          ",
      "# 6. 列出所有 app 的依赖软件（不依赖本地安装状态）                                      ",
      "Write-Host ''                                                                           ",
      "Write-Host '📦 各应用的依赖软件清单：' -ForegroundColor Cyan                            ",
      "Write-Host ('─' * 50) -ForegroundColor DarkGray                                         ",
      "                                                                                        ",
      "$allDeps = @()                                                                          ",
      "                                                                                        ",
      "foreach ($a in $targetApps) {                                                           ",
      "  $appName = $a.Split('/')[-1].Trim()                                                   ",
      "  $bucket  = if ($a -match '/') { $a.Split('/')[0].Trim() } else { 'main' }             ",
      "                                                                                        ",
      "  # 远程拉取 manifest（不要求本地已安装）                                               ",
      "  $appDeps = @()                                                                        ",
      "  $remoteManifest = scoop cat $appName 2>$null                                          ",
      "  if ($remoteManifest) {                                                                ",
      "    $parsed = $remoteManifest | ConvertFrom-Json                                        ",
      "    if ($parsed.depends) {                                                              ",
      "      $appDeps = @($parsed.depends | ForEach-Object { $_.Split('/')[-1].Trim() })       ",
      "    }                                                                                   ",
      "  }                                                                                     ",
      "                                                                                        ",
      "  if ($appDeps.Count -gt 0) {                                                           ",
      "    Write-Host ('  🔗 ' + $appName + ' (' + $bucket + ')') -ForegroundColor Yellow      ",
      "    Write-Host ('     依赖: ' + ($appDeps -join ', ')) -ForegroundColor White           ",
      "    $allDeps += $appDeps                                                                ",
      "  } else {                                                                              ",
      "    Write-Host ('  ✅ ' + $appName + ' (' + $bucket + ')') -ForegroundColor Green       ",
      "    Write-Host '     无额外依赖' -ForegroundColor DarkGray                              ",
      "  }                                                                                     ",
      "}                                                                                       ",
      "                                                                                        ",
      "# 汇总去重                                                                              ",
      "$allDeps = $allDeps | Select-Object -Unique                                             ",
      "                                                                                        ",
      "Write-Host ('─' * 50) -ForegroundColor DarkGray                                         ",
      "if ($allDeps.Count -gt 0) {                                                             ",
      "  Write-Host ('📋 所有依赖汇总（去重）: ' + ($allDeps -join ', ')) -ForegroundColor Cyan",
      "} else {                                                                                ",
      "  Write-Host '📋 所有应用均无额外依赖。' -ForegroundColor Green                         ",
      "}                                                                                       ",
      "                                                                                          ",
      "$targetApps = $targetApps + $allDeps | Select-Object -Unique                              ",
      "                                                                                          ",
      "$toInstall = @($targetApps | Where-Object { $_.Split('/')[-1].Trim() -notin $installed }) ",
      "                                                                                          ",
      "$trimTargetApps = @($targetApps | ForEach-Object {$_.Split('/')[-1].Trim()})              ",
      "$extraApps = @($installed | Where-Object { $_ -notin $trimTargetApps })                   ",
      "                                                                                          ",
      "if ($toInstall) {                                                                         ",
      "  Write-Host '🔧检测到以下依赖尚未安装，开始查漏补缺：' -ForegroundColor Cyan             ",
      "  Write-Host ($toInstall -join ' ') -ForegroundColor Yellow                               ",
      "  scoop install $toInstall  3>$null                                                       ",
      "} else {                                                                                  ",
      "  Write-Host '🎉完美！全家桶清单中的所有应用均已妥善安装。' -ForegroundColor Green        ",
      "}                                                                                         ",
      "# 5. 输出差异结果                                                                         ",
      "if ($extraApps) {                                                                         ",
      "  WARN '检测到本地已安装、但【未记入】当前全家桶清单的软件：'                             ",
      "  Write-Host ($extraApps -join ' ') -ForegroundColor Magenta                              ",
      "  INFO '提示：你可以将以上软件名称追加到清单的 apps_matrix 数组中。'                      ",
      "} else {                                                                                  ",
      "  INFO 🎉完美！本地已安装的所有软件均已 100% 被你的清单依赖追踪锁定。                     ",
      "}                                                                                         "
    ]
  },
  "uninstaller": { "script": [ ] }
}
