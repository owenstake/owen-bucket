{
  "version": "1.0",
  "description": "scoop enhance",
  "homepage": "https://github.com/owenstake/owen-bucket",
  "depends": [],
  "url": "https://github.com/owenstake/owen-bucket/releases/download/v1.0.0/Empty.txt",
  "hash": "2E1CFA82B035C26CBBBDAE632CEA070514EB8B773F616AAEAF668E2F0BE8F10D",
  "depends" : ["scoop-completion"],
  "psmodule": { "name": "default" },
  "pre_install" : [
    "''                                                                   ",
    "if (!($env:scoop)) {                                                 ",
    "  $shimsPath = Split-Path (Get-Command scoop.ps1).Source -Parent     ",
    "  $env:scoop = Split-Path $shimsPath -Parent                         ",
    "  [Environment]::SetEnvironmentVariable('scoop', $env:scoop, 'User') ",
    "  WARN ('Update $Env:Scoop from null to {0}' -f $env:scoop)          ",
    "} else {                                                             ",
    "  INFO ('$Env:Scoop is already {0}' -f $env:scoop)                   ",
    "}                                                                    ",
    "if ($null -ne $manifest.files) {                                     ",
    "  foreach ($prop in $manifest.files.psobject.Properties) {           ",
    "    if ($prop.Name -like 'default.*') {                              ",
    "      $filename = $prop.Name -replace 'default',$app                 ",
    "    } else {                                                         ",
    "      $filename = $prop.Name                                         ", 
    "    }                                                                ",
    "    $fullpath = Join-Path $dir $filename                             ",
    "    info ('Writing to ' + $fullpath)                                 ",
    "    Set-Content -Path $fullpath -Value $prop.value.trimend()         ",
    "  }                                                                  ",
    "}                                                                    "
  ],
  "installer": {
    "script": [
      "''                                                                             ",
      "if ($manifest.psmodule.name -eq 'default') {                                   ",
      "  $manifest.psmodule.name = $app                                               ",
      "}                                                                              ",
      "                                                                               ",
      "$shimsDir = Split-Path (Get-Command scoop.ps1).Source -Parent                  ",
      "$scoopCommandFiles = Get-ChildItem -LiteralPath $dir -Filter 'scoop-*.ps1'     ",
      "                                                                               ",
      "$newScoopCommands = $scoopCommandFiles | ForEach-Object {                      ",
      "  $_.Name -replace '^scoop-|\\.ps1$', ''                                       ",
      "}                                                                              ",
      "foreach ($c in $newScoopCommands) {                                            ",
      "  scoop alias add $c 'empty command' 'empty description'                       ",
      "}                                                                              ",
      "                                                                               ",
      "$scoopCommandFiles | Copy-Item -Destination $shimsDir -force                   ",
      "INFO ('Add scoop subcommands: ' + $newScoopCommands )                          ",
      "                                                                               ",
      "$scoopDir = scoop prefix scoop                                                 ",
      "$repoUrl = git -C $scoopDir config --get remote.origin.url                     ",
      "$repoBranch = git -C $scoopDir branch --show-current                           ",
      "                                                                               ",
      "$targetRepoUrl = 'https://gitee.com/mrair/scoop'                               ",
      "$targetBranch = 'develop'                                                      ",
      "if (($repoUrl -eq $targetRepoUrl) -and ($repoBranch -eq $targetBranch)) {      ",
      "  INFO ('scoop repo and branch is already {0}  {1}' -f                         ",
      "                                                 $targetRepoUrl,$targetBranch) ",
      "} else {                                                                       ",
      "  scoop config SCOOP_REPO   $targetRepoUrl *> $null                            ",
      "  scoop config SCOOP_BRANCH $targetBranch  *> $null                            ",
      "  WARN ('Changing scoop repo and branch to {0}  {1}' -f                        ",
      "                                                 $targetRepoUrl,$targetBranch) ",
      "  scoop update                                                                 ",
      "}                                                                              "
    ]
  },
  "post_install" : [
    "''                                                                            ",
    "Register-ModuleAliasConflicts $app                                            ",
    "                                                                              ",
    "INFO 'Patching scoop-completion for custom scoop subcommand'                  ",
    "$filePath = Join-Path (scoop prefix scoop-completion) 'scoop-completion.psm1' ",
    "                                                                              ",
    "# 1. 读取文件内容                                                             ",
    "$content = Get-Content $filePath                                              ",
    "                                                                              ",
    "# 2. 插入新代码到第 67 行                                                     ",
    "$insertLine = '$script:ScoopCommands = (scoop help 6>$null).command'          ",
    "$lineNumber = 67                                                              ",
    "$content = $content[0..($lineNumber - 2)] +                                   ",
    "$insertLine + $content[($lineNumber - 1)..($content.Length - 1)]              ",
    "                                                                              ",
    "# 3. 进行三处文本替换                                                         ",
    "# ArgumentCompleter for new scoop subcommand                                  ",
    "# Local packages for ArgumentCompleter                                        ",
    "$content = $content.replace('uninstall|cleanup',                              ",
    "                            'uninstall|reinstall|re|cd|cleanup')              ",
    "# Remote and Local packages for ArgumentCompleter                             ",
    "$content = $content.replace('download|cat', 'download|bat|v|vim|cat')         ",
    "# Remote packages for ArgumentCompleter                                       ",
    "$content = $content.replace('install|info', 'install|in|info')                ",
    "                                                                              ",
    "# 4. 将修改后的内容写回文件                                                   ",
    "$content | Set-Content $filePath -Encoding UTF8                               ",
    "                                                                              "
  ],
  "uninstaller": {
    "script": [
      "''                                                                         ",
      "if ($manifest.psmodule.name -eq 'default') {                               ",
      "  $manifest.psmodule.name = $app                                           ",
      "}                                                                          ",
      "Unregister-ModuleAliasConflicts $app                                       ",
      "remove-module $app -ea 0                                                   ",
      "import-module scoop-completion -force                                      ",
      "                                                                           ",
      "$files = Get-ChildItem -LiteralPath $dir -Filter 'scoop-*.ps1'             ",
      "                                                                           ",
      "$scoopCommandFiles = Get-ChildItem -LiteralPath $dir -Filter 'scoop-*.ps1' ",
      "$shimsDir = Split-Path (Get-Command scoop.ps1).Source -Parent              ",
      "foreach($f in $scoopCommandFiles) {                                        ",
      "  $fullpath = Join-Path $shimsDir $f.name                                  ",
      "  remove-item $fullpath                                                    ",
      "}                                                                          ",
      "                                                                           ",
      "$scoopSubcommands = $scoopCommandFiles | ForEach-Object {                  ",
      "  $_.Name -replace '^scoop-|\\.ps1$', ''                                   ",
      "}                                                                          ",
      "foreach ($c in $scoopSubcommands) {                                        ",
      "  scoop alias rm $c                                                        ",
      "}                                                                          ",
      "INFO ('Remove scoop subcommands: ' + $scoopSubcommands )                   ",
      "                                                                           "
    ]
  },
  "files" : {
    "default.psm1" : [
      "# Import-Module scoop-completion                                               ",
      "                                                                               ",
      "Function sv {                                                                  ",
      "  [CmdletBinding()]                                                            ",
      "  param(                                                                       ",
      "    [Parameter(ValueFromRemainingArguments=$true)]                             ",
      "    [ArgumentCompleter({                                                       ",
      "      param( $commandName, $parameterName, $wordToComplete,                    ",
      "             $commandAst, $fakeBoundParameters )                               ",
      "                                                                               ",
      "      # $apps = Get-ChildItem -Path $env:scoop/apps -Name -Directory           ",
      "      $apps = @(& Get-ChildItem -Path $env:scoop/buckets/ -Name |              ",
      "	     	 ForEach-Object {                                                       ",
      "          Get-ChildItem -Path $env:scoop/buckets/$_/bucket -Name -Filter *.json",
      "        } | ForEach-Object { $_ -replace '\\.json$', ''}                       ",
      "	     )                                                                        ",
      "      $apps | Where-Object { $_ -like ($wordToComplete + '*') } |              ",
      "        ForEach-Object {                                                       ",
      "          [System.Management.Automation.CompletionResult]::new(                ",
      "            $_, $_, 'ParameterValue', $_                                       ",
      "          )                                                                    ",
      "        }                                                                      ",
      "    })]                                                                        ",
      "    $app                                                                       ",
      "  )                                                                            ",
      "  scoop cat $app | nvim - -R -c 'set ft=json'                                  ",
      "  return                                                                       ",
      "}                                                                              ",
      "                                                                               ",
      "Function Invoke-FuzzyScoop {                                                   ",
      "  param(                                                                       ",
      "    [string]$subcommand = 'install',                                           ",
      "    [string]$subcommandflags = ''                                              ",
      "  )                                                                            ",
      "                                                                               ",
      "  $result = $null                                                              ",
      "  $shimsDir = Split-Path (Get-Command scoop.ps1).Source -Parent                ",
      "  $scoopDir = Split-Path $shimsDir -Parent                                     ",
      "  if ($scoopDir) {                                                             ",
      "    $apps = New-Object System.Collections.ArrayList                            ",
      "    Get-ChildItem (Join-Path $scoopDir buckets) | ForEach-Object {             ",
      "      $bucket = $_.Name                                                        ",
      "      Get-ChildItem (Join-Path $_.FullName bucket) -R -File -Filter '*.json' | ",
      "        ForEach-Object {                                                       ",
      "        $apps.Add((Join-Path $bucket $_.BaseName)) > $null                     ",
      "      }                                                                        ",
      "    }                                                                          ",
      "    $result = $apps | Invoke-Fzf -Multi -PreviewWindow wrap -Preview '         ",
      "             scoop info {}' -Header 'Scoop Applications'                       ",
      "  }                                                                            ",
      "                                                                               ",
      "  if ($null -ne $result) {                                                     ",
      "    & scoop $subcommand $($result -join ' ') $subcommandflags                  ",
      "  }                                                                            ",
      "}                                                                              ",
      "                                                                               ",
      "Function Get-LnkForScoopApp($app) {                                            ",
      "  $programsDir = [Environment]::GetFolderPath('Programs')                      ",
      "  $scoopLnkDir = Join-Path $programsDir 'Scoop Apps'                           ",
      "                                                                               ",
      "  # Low cost invasion for host os. we are Parasitic system                     ",
      "  $j = $(scoop cat $app | ConvertFrom-Json )                                   ",
      "  if (!($j)) {                                                                 ",
      "    Write-host ('Skip it. manifest is null in ' + $app)                        ",
      "    return $null                                                               ",
      "  }                                                                            ",
      "  if (!($j.shortcuts)) {                                                       ",
      "    Write-Host ('Skip it. shortcuts is null in ' + $app)                       ",
      "    return                                                                     ",
      "  }                                                                            ",
      "  if (!($j.shortcuts[0][1])) {                                                 ",
      "    Write-Host ('Skip it. shortcuts[0][1] is null in ' + $app)                 ",
      "    return $null                                                               ",
      "  }                                                                            ",
      "  $filename = $j.shortcuts[0][1] + '.lnk'                                      ",
      "  $lnkFile = Join-Path $scoopLnkDir $filename                                  ",
      "  if (!(Test-Path $lnkFile))  {                                                ",
      "    Write-Error ('No Exists for ' + $lnkFile)                                  ",
      "    return $null                                                               ",
      "  }                                                                            ",
      "  return $lnkFile                                                              ",
      "}                                                                              ",
      "                                                                               ",
      "function Get-AppLnk {                                                          ",
      "  [CmdletBinding()]                                                            ",
      "  param(                                                                       ",
      "    [Parameter(Mandatory = $true, Position = 0)]                               ",
      "    [string]$AppExe                                                            ",
      "  )                                                                            ",
      "                                                                               ",
      "  # 1. 规范化：去末尾 .exe，转小写                                             ",
      "  $targetName = ($AppExe -replace '[.]exe$', '').ToLower()                     ",
      "                                                                               ",
      "  # 2. 获取开始菜单路径                                                        ",
      "  $searchPaths = @(                                                            ",
      "    [Environment]::GetFolderPath('Programs'),                                  ",
      "    [Environment]::GetFolderPath('CommonPrograms')                             ",
      "  )                                                                            ",
      "                                                                               ",
      "  # 3. 获取 .lnk（过滤卸载程序）                                               ",
      "  $lnkParams = @{                                                              ",
      "    Path = $searchPaths                                                        ",
      "    Filter = '*.lnk'                                                           ",
      "    Recurse = $true                                                            ",
      "    ErrorAction = 'SilentlyContinue'                                           ",
      "  }                                                                            ",
      "  $lnkFiles = Get-ChildItem @lnkParams |                                       ",
      "    Where-Object { $_.Name -notmatch '^(Uninstall)' }                          ",
      "    #Where-Object { $_.Name -notmatch '^(Uninstall|卸载)' }                    ",
      "                                                                               ",
      "  if (-not $lnkFiles) {                                                        ",
      "    Write-Error ('No application matching [{0}] was found.' -f $AppExe)        ",
      "    return                                                                     ",
      "  }                                                                            ",
      "                                                                               ",
      "  # 4. 创建单一 COM 对象                                                       ",
      "  $shell = New-Object -ComObject WScript.Shell                                 ",
      "                                                                               ",
      "  # 封装 Add-Member 参数，彻底告别反引号                                       ",
      "  $memberParams = @{                                                           ",
      "    NotePropertyName = 'RealExePath'                                           ",
      "    Force = $true                                                              ",
      "  }                                                                            ",
      "                                                                               ",
      "  try {                                                                        ",
      "    # 【第一遍】：优先匹配 LNK 名字                                            ",
      "    foreach ($lnk in $lnkFiles) {                                              ",
      "      if ($lnk.BaseName.ToLower() -eq $targetName) {                           ",
      "        $targetPath = $shell.CreateShortcut(                                   ",
      "          $lnk.FullName                                                        ",
      "        ).TargetPath                                                           ",
      "                                                                               ",
      "        # 只要 LNK 名字匹配，直接返回                                          ",
      "        $memberParams.NotePropertyValue = $targetPath                          ",
      "        $lnk | Add-Member @memberParams                                        ",
      "        return $lnk                                                            ",
      "      }                                                                        ",
      "    }                                                                          ",
      "                                                                               ",
      "    # 【第二遍】：兜底匹配 EXE 名字                                            ",
      "    foreach ($lnk in $lnkFiles) {                                              ",
      "      $tempTarget = $shell.CreateShortcut(                                     ",
      "        $lnk.FullName                                                          ",
      "      ).TargetPath                                                             ",
      "                                                                               ",
      "      if ($tempTarget -and (Test-Path -Path $tempTarget -PathType Leaf)) {     ",
      "        $exeBaseName = [System.IO.Path]::GetFileNameWithoutExtension(          ",
      "          $tempTarget                                                          ",
      "        ).ToLower()                                                            ",
      "                                                                               ",
      "        if ($exeBaseName -eq $targetName) {                                    ",
      "          $memberParams.NotePropertyValue = $tempTarget                        ",
      "          $lnk | Add-Member @memberParams                                      ",
      "          return $lnk                                                          ",
      "        }                                                                      ",
      "      }                                                                        ",
      "    }                                                                          ",
      "  }                                                                            ",
      "  finally {                                                                    ",
      "    # 5. 释放 COM 对象                                                         ",
      "    if ($shell) {                                                              ",
      "      [System.Runtime.InteropServices.Marshal]::ReleaseComObject(              ",
      "        $shell                                                                 ",
      "      ) | Out-Null                                                             ",
      "    }                                                                          ",
      "    [System.GC]::Collect()                                                     ",
      "    [System.GC]::WaitForPendingFinalizers()                                    ",
      "  }                                                                            ",
      "                                                                               ",
      "  Write-Error ('No matching shortcut found for [{0}].' -f $AppExe)             ",
      "}                                                                              ",
      "                                                                               ",
      "Function Start-App($app) {                                                     ",
      "  Explorer.exe (Get-AppLnk $app)                                               ",
      "}                                                                              ",
      "                                                                               ",
      "# 核心底层 API：在隔离 Runspace 中加载并获取模块信息（绝对防污染）              ",
      "function Get-ModuleInNewRunspace {                                              ",
      "  param(                                                                        ",
      "    [Parameter(Mandatory=$true)][string]$ModuleName                             ",
      "  )                                                                             ",
      "                                                                                ",
      "  $ps = [PowerShell]::Create()                                                  ",
      "                                                                                ",
      "  # 【极致优化】使用 -PassThru 直接返回模块对象，省去 Get-Module 二次查询       ",
      "  $scriptBlock = {                                                              ",
      "    param($Name)                                                                ",
      "    Import-Module -Name $Name -Force -PassThru -ea Stop -wa SilentlyContinue    ",
      "  }                                                                             ",
      "                                                                                ",
      "  try {                                                                         ",
      "    $ps.AddScript($scriptBlock.ToString()) | Out-Null                           ",
      "    $ps.AddArgument($ModuleName) | Out-Null                                     ",
      "                                                                                ",
      "    return $ps.Invoke()                                                         ",
      "  } catch {                                                                     ",
      "    Write-Warning (                                                             ",
      "      'Failed to get module [' + $ModuleName + '] in new Runspace: ' +          ",
      "           $_.Exception.Message                                                 ",
      "    )                                                                           ",
      "    return $null                                                                ",
      "  } finally {                                                                   ",
      "    # 【安全回收】无论成功失败，必须释放 Runspace 防止内存泄漏                  ",
      "    if ($ps) { $ps.Dispose() }                                                  ",
      "  }                                                                             ",
      "}                                                                               ",
      "                                                                                ",
      "# direct from psm1                                                                ",
      "function Build-ModuleManifest {                                                     ",
      "  param(                                                                            ",
      "    [Parameter(Mandatory=$true)] [string]$ModuleName,                               ",
      "    [Parameter(Mandatory=$true)] [string]$ModulePath                                ",
      "  )                                                                                 ",
      "                                                                                    ",
      "  # 【唯一真理】调用底层 API 获取沙盒模块对象                                       ",
      "  try {                                                                             ",
      "    $m = Get-ModuleInNewRunspace -ModuleName $ModuleName                            ",
      "    if (-not $m) { return }                                                         ",
      "  } catch {                                                                         ",
      "    Write-Warning (                                                                 ",
      "      'Failed to scan module [' + $ModuleName + '] in isolated Runspace: ' +        ",
      "      $_.Exception.Message                                                          ",
      "    )                                                                               ",
      "    return                                                                          ",
      "  }                                                                                 ",
      "                                                                                    ",
      "  $psd1Path = Join-Path $ModulePath ($ModuleName + '.psd1')                         ",
      "                                                                                    ",
      "  # fix cd missing                                                                  ",
      "  $alias = get-command -module $ModuleName -CommandType alias                       ",
      "  $params = @{                                                                      ",
      "    Path = $psd1Path                                                                ",
      "    RootModule = $ModuleName + '.psm1'                                              ",
      "    ModuleVersion = $m.version                                                      ",
      "    FunctionsToExport = $m.ExportedFunctions.Keys | Where-Object {$_ -notlike '__*'}",
      "    CmdletsToExport = @($m.ExportedCmdlets.Keys)                                    ",
      "    AliasesToExport = @($alias)                                                     ",
      "  }                                                                                 ",
      "  New-ModuleManifest @params                                                        ",
      "                                                                                    ",
      "  Write-Host 'Generate module mainfest ' $psd1Path -F Green                         ",
      "  # 统计并输出结果                                                                  ",
      "  $msg = 'Module manifest updated: {0} functions, {1} aliases.'                     ",
      "  Write-Host ($msg -f                                                               ",
      "    $m.ExportedFunctions.Count,                                                     ",
      "    $m.ExportedAliases.Count                                                        ",
      "  ) -ForegroundColor Green                                                          ",
      "                                                                                    ",
      "  return                                                                            ",
      "}                                                                                   ",
      "                                                                                    "
    ],
    "scoop-cd.ps1": [
      "# Summary: Faster cd to scoop app directory with app name                        ",
      "if (!($env:scoop)) {write-warning '`$env:scoop is null. Set it first! '; exit -1}",
      "$appsDir = Join-Path $env:scoop 'apps'                                           ",
      "$app = $args[0]                                                                  ",
      "if ([string]::isnullorEmpty($app)) {                                             ",
      "  cd $env:scoop                                                                  ",
      "} else {                                                                         ",
      "  $scoopAppDir = Join-Path $appsDir $app                                         ",
      "  $scoopAppDir = Join-Path $scoopAppDir 'current'                                ",
      "  if (test-path $scoopAppDir -ea 0) {                                            ",
      "    cd $scoopAppDir                                                              ",
      "  } else {                                                                       ",
      "    write-warning ($app + ' is not installed')                                   ",
      "    exit -1                                                                      ",
      "  }                                                                              ",
      "}                                                                                "
    ],
    "scoop-reinstall.ps1": [
      "# Summary: Safely uninstalls and reinstalls applications                         ",
      "if (!($env:scoop)) {write-warning '`$env:scoop is null. Set it first! '; exit -1}",
      "$appsDir = Join-Path $env:scoop 'apps'                                           ",
      "                                                                                 ",
      "ForEach ($app in $args) {                                                        ",
      "  Write-Host ('--- Re-installing {0} ---' -f $app) -F Cyan                       ",
      "                                                                                 ",
      "  $scoopAppDir = Join-Path $appsDir $app                                         ",
      "  $scoopAppDir = Join-Path $scoopAppDir 'current'                                ",
      "  if (Test-Path $scoopAppDir) {                                                  ",
      "    scoop uninstall $app                                                         ",
      "  } else {                                                                       ",
      "    write-warning ($app + ' is not installed. Skipping uninstall.')              ",
      "  }                                                                              ",
      "                                                                                 ",
      "  scoop install $app                                                             ",
      "}                                                                                "
    ],
    "scoop-bat.ps1": [
      "# Summary: bat - better cat for manifest                                         ",
      "if (!($env:scoop)) {write-warning '`$env:scoop is null. Set it first! '; exit -1}",
      "                                                                                 ",
      "$app = $args[0]                                                                  ",
      "scoop cat $app | bat -l json                                                     "
    ],
    "scoop-v.ps1": [
      "# Summary: nvim for manifest                                                        ",
      "$env:scoop = Split-Path (Split-Path (Get-Command scoop.ps1).Source -Parent) -Parent ",
      "                                                                                    ",
      "$app = $args[0]                                                                     ",
      "scoop cat $app | nvim - -R -c 'set ft=json'                                         "
    ],
    "scoop-vim.ps1": [
      "# Summary: nvim for manifest                                                        ",
      "$env:scoop = Split-Path (Split-Path (Get-Command scoop.ps1).Source -Parent) -Parent ",
      "                                                                                    ",
      "$app = $args[0]                                                                     ",
      "scoop cat $app | nvim - -R -c 'set ft=json'                                         "
    ],
    "scoop-in.ps1": [
      "# Summary: in is alias for install ",
      "scoop install @args                "
    ],
    "scoop-un.ps1": [
      "# Summary: un is alias for uninstall ",
      "scoop uninstall @args                "
    ],
    "scoop-re.ps1": [
      "# Summary: re is alias for reinstall ",
      "scoop reinstall @args                "
    ]
  }
}
