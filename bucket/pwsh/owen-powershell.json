{
  "version": "1.0",
  "description": "Pwsh input enhance before 'Enter' click",
  "homepage": "https://github.com/owenstake/owen-bucket",
  "url": "https://github.com/owenstake/owen-bucket/releases/download/v1.0.0/Empty.txt",
  "hash": "2E1CFA82B035C26CBBBDAE632CEA070514EB8B773F616AAEAF668E2F0BE8F10D",
  "psmodule": { "name": "default" },
  "pre_install" : [
    "''                                                           ",
    "if ($null -ne $manifest.files) {                             ",
    "  foreach ($prop in $manifest.files.psobject.Properties) {   ",
    "    if ($prop.Name -like 'default.*') {                      ",
    "      $filename = $prop.Name -replace 'default',$app         ",
    "    } else {                                                 ",
    "      $filename = $prop.Name                                 ", 
    "    }                                                        ",
    "    $fullpath = Join-Path $dir $filename                     ",
    "    INFO ('Writing to ' + $fullpath)                         ",
    "    $prop.Value = $prop.Value -replace '(?m)\\s+$', ''       ",
    "    Set-Content -Path $fullpath -Value $prop.value.trimEnd() ",
    "  }                                                          ",
    "}                                                            "
  ],
  "installer": {
    "script": [
      "''                                                                                  ",
      "if ($manifest.psmodule.name -eq 'default') {                                        ",
      "  $manifest.psmodule.name = $app                                                    ",
      "}                                                                                   ",
      "                                                                                    ",
      "$myDoc = [Environment]::GetFolderPath('MyDocuments')                                ",
      "$ps5profile = Join-path $myDoc 'WindowsPowerShell/Microsoft.PowerShell_profile.ps1' ",
      "$ps7profile = Join-path $myDoc 'PowerShell/Microsoft.PowerShell_profile.ps1'        ",
      "foreach ($p in $ps5profile,$ps7profile) {                                           ",
      "  # backup                                                                          ",
      "  $bak = $p + '.bak'                                                                ",
      "  if (Test-Path $p) {                                                               ",
      "    Copy-Item -Path $p -Destination $bak -Force                                     ",
      "    INFO ('Backup profile: ' + $bak)                                                ",
      "  } else {                                                                          ",
      "    INFO 'Profile no exist, no bakcup'                                              ",
      "  }                                                                                 ",
      "  Set-Content -Path $p -Value ('import-module {0}' -f $app)                         ",
      "  INFO ('Update powershell profile {0}' -f $p)                                      ",
      "}                                                                                   ",
      "                                                                                    "
    ]
  },
  "uninstaller": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') {                                        ",
      "  $manifest.psmodule.name = $app                                                    ",
      "}                                                                                   ",
      "remove-module $app -ea 0                                                            ",
      "                                                                                    ",
      "# Restore backup file                                                               ",
      "$myDoc = [Environment]::GetFolderPath('MyDocuments')                                ",
      "$ps5profile = Join-path $myDoc 'WindowsPowerShell/Microsoft.PowerShell_profile.ps1' ",
      "$ps7profile = Join-path $myDoc 'PowerShell/Microsoft.PowerShell_profile.ps1'        ",
      "foreach ($p in $ps5profile,$ps7profile) {                                           ",
      "  $bak = $p + '.bak'                                                                ",
      "  if (Test-Path $bak) {                                                             ",
      "    Move-Item -Path $bak -Destination $p -Force                                     ",
      "    . $p                                                                            ",
      "    INFO ('Restore and dot-source backup file ' + $p)                               ",
      "  } else {                                                                          ",
      "    INFO ('No found backup file: ' + $bak )                                         ",
      "  }                                                                                 ",
      "}                                                                                   ",
      "                                                                                    "
    ]
  },
  "files" : {
    "default.psm1" : [
      ". $PSScriptRoot/lib.ps1                                                       ",
      "                                                                              ",
      "# ============== SCRIPT EXCUTING BEGIN HERE ==================                ",
      "# Accelerate profile loading for script execution which is not in cli mode    ",
      "If (!(IsInteractive)) { exit 2 }    # Exit if we are in script.               ",
      "# ========== !!! SCRIPT EXCUTING END HERE !!! ================                ",
      "                                                                              ",
      "# ========== CLI CONFIG BEGIN ================================                ",
      "# import-module input-enhance-pwsh                                            ",
      "                                                                              ",
      "# Dot source ps1 file                                                         ",
      "$scriptFiles = Get-ChildItem -LiteralPath $PSScriptRoot -Filter '*.ps1' -ea 0 ",
      "foreach ($file in $scriptFiles) {                                             ",
      "  if ($file.Name -ne 'ignore-this.ps1') { . $file.FullName }                  ",
      "}                                                                             ",
      "                                                                              ",
      "Resolve-AliasConflicts                                                        ",
      "                                                                              ",
      "# ENV setting                                                                 ",
      "$env:EDITOR = 'nvim'                                                          ",
      "# $env:PAGER  = 'bat'                                                         ",
      "# $env:SHELL='powershell'                                                     ",
      "                                                                              ",
      "# change default location                                                     ",
      "If($pwd.path -eq $Env:USERPROFILE) {                                          ",
      "  # wezterm not specified the cwd                                             ",
      "  set-location $Env:Home                                                      ",
      "} else {                                                                      ",
      "  # wezterm specified the cwd                                                 ",
      "}                                                                             ",
      "                                                                              ",
      "exit 0                                                                        ",
      "# ========== CLI CONFIG END ==================================                ",
      "                                                                              "
    ],
    "lib.ps1" : [
      "# [Powershell test for noninteractive mode - Stack Overflow]                  ",
      "# https://stackoverflow.com/questions/9738535/                                ",
      "# powershell-test-for-noninteractive-mode                                     ",
      "function IsInteractive {                                                      ",
      "  # not including `-NonInteractive` since it apparently does nothing          ",
      "  # Does not present an interactive prompt to the user - no, it does present! ",
      "  $non_interactive = '-command', '-c', '-encodedcommand',                     ",
      "                        '-e', '-ec', '-file', '-f', '-noexit'                 ",
      "  $interactive = , '-noexit'                                                  ",
      "                                                                              ",
      "  If ([Environment]::GetCommandLineArgs() |                                   ",
      "            Where-Object -FilterScript {$PSItem -in $interactive}) {          ",
      "    return $true                                                              ",
      "  }                                                                           ",
      "  # alternatively `$non_interactive [-contains|-eq] $PSItem`                  ",
      "  -not ([Environment]::GetCommandLineArgs() |                                 ",
      "            Where-Object -FilterScript {$PSItem -in $non_interactive})        ",
      "}                                                                             "
    ],
    "misc-apps.ps1" : [
      "# tmux                                                               ",
      "Function ta  { tmux attach @args       }                             ",
      "Function tn  { tmux new @args          }                             ",
      "Function tls { tmux list-sessions @args}                             ",
      "Function tk  { tmux kill-session @args }                             ",
      "Function tp  { tmuxpanel @args         }                             ",
      "                                                                     ",
      "# vim                                                                ",
      "Function vic { vim ~/_vimrc }                                        ",
      "                                                                     ",
      "## git function                                                      ",
      "del alias:gc  -errorAction silentlyContinue                          ",
      "del alias:glg -errorAction silentlyContinue                          ",
      "set-alias gst invoke-gst                                             ",
      "Function ga   {git add                  @args}                       ",
      "Function gd   {git diff --color @args | bat --style plain }          ",
      "Function invoke-gst  {git status               @args}                ",
      "Function gc   {git commit               @args}                       ",
      "Function gca  {git commit -v -a         @args}                       ",
      "Function glg  {git log --stat           @args}                       ",
      "Function grbi {git rebase --interactive @args}                       ",
      "                                                                     ",
      "Function trash-restore {                                             ",
      "  $lines = $(trash list --rev | fzf --multi --reverse )              ",
      "  if($lines) {                                                       ",
      "    $files = @()                                                     ",
      "    foreach ($l in $lines ) {                                        ",
      "      $files += ($l -split '\\s+')[-2]                               ",
      "    }                                                                ",
      "    if($file) {                                                      ",
      "      trash restore --match=exact $files                             ",
      "    }                                                                ",
      "  }                                                                  ",
      "}                                                                    ",
      "                                                                     ",
      "# typora                                                             ",
      "Function ty($pathName='.') {                                         ",
      "  $pathName = $pathName.Trim([char]34)    # 34 is double quote       ",
      "  If ( !(Test-Path $pathName )) {                                    ",
      "    throw [System.IO.FileNotFoundException] ($pathName + 'not found')",
      "  }                                                                  ",
      "  return typora.exe $pathName                                        ",
      "}                                                                    ",
      "                                                                     ",
      "# draw.io                                                            ",
      "Function da($pathName='.') {                                         ",
      "  $pathName = $pathName.Trim([char]34)    # 34 is double quote       ",
      "  If ( !(Test-Path $pathName )) {                                    ",
      "    throw [System.IO.FileNotFoundException] ($pathName + 'not found')",
      "  }                                                                  ",
      "  Start-Process -NoNewWindow draw.io.exe $pathName                   ",
      "  return                                                             ",
      "}                                                                    ",
      "                                                                     "
    ],
    "1-psreadline-config.ps1" : [
      "# PSReadLine config should be prior to psfzf                         ",
      "                                                                     ",
      "$predictionSource = if ($PSVersionTable.PSVersion.Major -ge 7) {     ",
      "  'HistoryAndPlugin' } else { 'History' }                            ",
      "$PSROptions = @{                                                     ",
      "  EditMode                      = 'Emacs'                            ",
      "  HistorySearchCursorMovesToEnd = $true                              ",
      "  PredictionSource              = $predictionSource                  ",
      "}                                                                    ",
      "Set-PSReadLineOption @PSROptions                                     ",
      "                                                                     ",
      "# Shows navigable menu of all options when hitting Tab               ",
      "Set-PSReadlineKeyHandler -Key Tab -Function MenuComplete             ",
      "# Autocompletion for arrow keys                                      ",
      "Set-PSReadlineKeyHandler -Key Ctrl+p -Function HistorySearchBackward ",
      "Set-PSReadlineKeyHandler -Key Ctrl+n -Function HistorySearchForward  ",
      "                                                                     ",
      "$psrlKeyOptions = @{                                                 ",
      "  Key              = 'Ctrl+e'                                        ",
      "  BriefDescription = 'Go to EndOfLine or AcceptSuggestion'           ",
      "  LongDescription  = 'If cursor is not at the end of line,' +        ",
      "        'then go to end of line, otherwise try to AcceptSuggestion'  ",
      "  ScriptBlock      = {                                               ",
      "    $line = $cursor = $null                                          ",
      "    [Microsoft.PowerShell.PSConsoleReadLine]::GetBufferState(        ",
      "                      [ref]$line, [ref]$cursor)                      ",
      "    if ($cursor -lt $line.Length) {                                  ",
      "      [Microsoft.PowerShell.PSConsoleReadLine]::EndOfLine()          ",
      "    } else {                                                         ",
      "      [Microsoft.PowerShell.PSConsoleReadLine]::AcceptSuggestion()   ",
      "    }                                                                ",
      "  }                                                                  ",
      "}                                                                    ",
      "Set-PSReadLineKeyHandler @psrlKeyOptions                             ",
      "                                                                     ",
      "# Export-ModuleMember                                                "
    ],
    "scoop-config.ps1" : [
      "set-alias s scoop -scope global # must prior to scoop-completion ",
      "                                                                 ",
      "Import-Module scoop-completion -global                           ",
      "                                                                 "
    ],
    "psfzf-config.ps1" : [
      "# Env psfzf                                                                     ",
      "# Fzf is use cmd.exe as default shell if $env:shell or %SHELL% is not set.      ",
      "# psfzf config should be posterior to psreadline                                ",
      "                                                                                ",
      "$env:FZF_CTRL_T_COMMAND='                                                       ",
      "  $InputEncoding = $OutputEncoding =                                            ",
	  	"  [Console]::OutputEncoding = [Console]::InputEncoding =                        ",
	  	"  [System.Text.Encoding]::utf8  # fix chinese garbled char                      ",
      "  fd --color always                                                             ",
      "'                                                                               ",
      "                                                                                ",
      "$fzfEzaOpt = 'eza --no-quotes --color=always ' +                                ",
      "                 '--sort new --reverse {0}{1}{0}' -f [char]34,'%cd%'            ",
      "                                                                                ",
      "$env:FZF_CTRL_T_OPTS='                                                          ",
      "  --multi --border --reverse --ansi --height 60%                                ",
      "  --prompt  {0}All> {0}                                                         ",
      "  --preview {0}(bat --color=always {{}} || eza {{}} -1 --color always) 2> nul{0}",
      "  --header  {0}CTRL-D: Dirs / CTRL-F: Files / CTRL-T: SortTime / CTRL-O: Open   ",
      "/ CTRL-Y: Copy File / CTRL-I: Copy FullPath {0}                                 ",
      "  --bind {1}ctrl-/:toggle-preview{1}                                            ",
      "  --bind {1}ctrl-d:change-prompt(Directories> )+reload(fd --type directory){1}  ",
      "  --bind {1}ctrl-f:change-prompt(Files> )+reload(fd --type file ){1}            ",
      "  --bind {1}ctrl-t:change-prompt(Sort by time> )+reload({2}){1}                 ",
      "  --bind {1}ctrl-o:execute-silent(pwsh -c Invoke-Item {0}{{}}{0} ){1}           ",
      "  --bind {1}ctrl-i:execute-silent(pwsh -c Set-Clipboard {0}%cd%/{{}}{0}){1}     ",
      "  --bind {1}ctrl-y:execute-silent(pwsh -c yww {0}{{}}{0}){1}                    ",
      "' -f [char]39,[char]34,$fzfEzaOpt                                               ",
      "                                                                                ",
      "$psFzfOptions = @{                                                              ",
      "  PSReadlineChordProvider       = 'Ctrl+t'                                      ",
      "  PSReadlineChordReverseHistory = 'Ctrl+r'                                      ",
      "  EnableAliasFuzzyGitStatus     = $true                                         ",
      "  EnableAliasFuzzyKillProcess   = $true                                         ",
      "  EnableAliasFuzzyScoop         = $true                                         ",
      "}                                                                               ",
      "Set-PsFzfOption @psFzfOptions                                                   ",
      "                                                                                ",
      "Set-Alias -Name frg -Value 'Invoke-PsFzfRipgrep'                                ",
      "Set-Alias -Name fsc -Value 'Invoke-FuzzyScoop'                                  ",
      "                                                                                "
    ],
    "remove-dot-prefix.ps1" : [
      "# https://github.com/PowerShell/PowerShell/issues/18180#issuecomment-1510398769              ",
      "function TabExpansion2 {                                                                     ",
      "  [CmdletBinding(DefaultParameterSetName = 'ScriptInputSet')]                                ",
      "  [OutputType([System.Management.Automation.CommandCompletion])]                             ",
      "  Param                                                                                      ",
      "  (                                                                                          ",
      "    [Parameter(ParameterSetName = 'ScriptInputSet', Mandatory = $true, Position = 0)]        ",
      "    [string] $inputScript,                                                                   ",
      "                                                                                             ",
      "    [Parameter(ParameterSetName = 'ScriptInputSet', Position = 1)]                           ",
      "    [int] $cursorColumn = $inputScript.Length,                                               ",
      "                                                                                             ",
      "    [Parameter(ParameterSetName = 'AstInputSet', Mandatory = $true, Position = 0)]           ",
      "    [System.Management.Automation.Language.Ast] $ast,                                        ",
      "                                                                                             ",
      "    [Parameter(ParameterSetName = 'AstInputSet', Mandatory = $true, Position = 1)]           ",
      "    [System.Management.Automation.Language.Token[]] $tokens,                                 ",
      "                                                                                             ",
      "    [Parameter(ParameterSetName = 'AstInputSet', Mandatory = $true, Position = 2)]           ",
      "    [System.Management.Automation.Language.IScriptPosition] $positionOfCursor,               ",
      "                                                                                             ",
      "    [Parameter(ParameterSetName = 'ScriptInputSet', Position = 2)]                           ",
      "    [Parameter(ParameterSetName = 'AstInputSet', Position = 3)]                              ",
      "    [Hashtable] $options = $null                                                             ",
      "  )                                                                                          ",
      "                                                                                             ",
      "  Set-StrictMode -Version 1                                                                  ",
      "                                                                                             ",
      "  # The original TabExpansion2 code.                                                         ",
      "  $completionOutput =                                                                        ",
      "    if ($psCmdlet.ParameterSetName -eq 'ScriptInputSet') {                                   ",
      "      [System.Management.Automation.CommandCompletion]::CompleteInput(                       ",
      "        <#inputScript#>  $inputScript,                                                       ",
      "        <#cursorColumn#> $cursorColumn,                                                      ",
      "        <#options#>      $options)                                                           ",
      "    }                                                                                        ",
      "    else {                                                                                   ",
      "      [System.Management.Automation.CommandCompletion]::CompleteInput(                       ",
      "        <#ast#>              $ast,                                                           ",
      "        <#tokens#>           $tokens,                                                        ",
      "        <#positionOfCursor#> $positionOfCursor,                                              ",
      "        <#options#>          $options)                                                       ",
      "    }                                                                                        ",
      "                                                                                             ",
      "  $completionOutput.CompletionMatches = @(                                                   ",
      "    foreach ($item in $CompletionOutput.CompletionMatches) {                                 ",
      "      $isFileOrDirArg =                                                                      ",
      "        if ($item.ResultType -in                                                             ",
      "            [System.Management.Automation.CompletionResultType]::ProviderContainer,          ",
      "            [System.Management.Automation.CompletionResultType]::ProviderItem                ",
      "           ) {                                                                               ",
      "          $pstokens = [System.Management.Automation.PSParser]::Tokenize(                     ",
      "                     $inputScript.Substring(0, $cursorColumn), [ref] $null)                  ",
      "                                                                                             ",
      "          # Determine if the last token is an argument.                                      ",
      "          switch ($pstokens[-1].Type) {                                                      ",
      "            'CommandArgument' {                                                              ",
      "              # An unquoted argument.                                                        ",
      "              $true; break                                                                   ",
      "            }                                                                                ",
      "            { $_ -in 'String', 'Number' } {                                                  ",
      "              switch ($pstokens[-2].Type) {                                                  ",
      "                $null { $false; break } # Token at hand is first token? -> command.          ",
      "                'Operator' { $pstokens[-2].Content -notin '.', '&', '|', '&&', '||'; break } ",
      "                'GroupStart' { $false; break }                                               ",
      "                'StatementSeparator' { $false; break }                                       ",
      "                Default { $true } # Everything else: assume an argument.                     ",
      "              }                                                                              ",
      "            }                                                                                ",
      "          }                                                                                  ",
      "        }                                                                                    ",
      "      if ($isFileOrDirArg) {                                                                 ",
      "        [System.Management.Automation.CompletionResult]::new(                                ",
      "           ($item.CompletionText -replace '^([''\"]?)\\.[/\\\\]', '$1'),                     ",
      "           $item.ListItemText,                                                               ",
      "           $item.ResultType,                                                                 ",
      "           $item.ToolTip)                                                                    ",
      "      }                                                                                      ",
      "      else {                                                                                 ",
      "        # Otherwise, pass through.                                                           ",
      "        $item                                                                                ",
      "      }                                                                                      ",
      "    }                                                                                        ",
      "  )                                                                                          ",
      "  return $completionOutput                                                                   ",
      "}                                                                                            ",
      "                                                                                             ",
      "# Export-ModuleMember -Function *                                                            "
    ]
  }
}
