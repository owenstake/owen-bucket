{
  "version": "1.0",
  "description": "Auto fix alias conflicks for module auto-loading",
  "homepage": "https://github.com/owenstake/owen-bucket",
  "depends": [],
  "url": "https://github.com/owenstake/owen-bucket/releases/download/v1.0.0/Empty.txt",
  "hash": "2E1CFA82B035C26CBBBDAE632CEA070514EB8B773F616AAEAF668E2F0BE8F10D",
  "psmodule": { "name": "default" },
  "persist": ["config"],
  "pre_install" : [
    "''                                                           ",
    "if (!($env:scoop)) {                                         ",
    "  write-warning '`$env:scoop is null. Set it first! '        ",
    "  exit -1                                                    ",
    "}                                                            ",
    "if ($null -ne $manifest.files) {                             ",
    "  foreach ($prop in $manifest.files.psobject.Properties) {   ",
    "    if ($prop.Name -like 'default.*') {                      ",
    "      $filename = $prop.Name -replace 'default',$app         ",
    "    } else {                                                 ",
    "      $filename = $prop.Name                                 ", 
    "    }                                                        ",
    "    $fullpath = Join-Path $dir $filename                     ",
    "    info ('Writing to ' + $fullpath)                         ",
    "    Set-Content -Path $fullpath -Value $prop.value.trimEnd() ",
    "  }                                                          ",
    "}                                                            "
  ],
  "installer": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') { ",
      "  $manifest.psmodule.name = $app             ",
      "}                                            "
    ]
  },
  "uninstaller": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') { ",
      "  $manifest.psmodule.name = $app             ",
      "}                                            ",
      "remove-module $app -ea 0                     "
    ]
  },
  "files" : {
    "default.psm1" : [
      "# alias-blacklist.psm1                                                              ",
      "# 获取当前模块名称                                                                  ",
      "$script:CurrentModuleName = Split-Path -Path $PSScriptRoot -Leaf                    ",
      "                                                                                    ",
      "# 定义中心配置文件路径                                                              ",
      "$configDir = Join-Path $PSScriptRoot 'config'                                       ",
      "$script:BlacklistFilePath = Join-Path $configDir 'alias-blacklist.json'             ",
      "                                                                                    ",
      "# 1. 读取中心配置数据（兼容 PS 5.1 与 PS 7+）                                       ",
      "function Get-BlacklistData {                                                        ",
      "  if (Test-Path $script:BlacklistFilePath) {                                        ",
      "    $jsonContent = Get-Content -Path $script:BlacklistFilePath -Raw                 ",
      "    if ($PSVersionTable.PSVersion.Major -ge 7) {                                    ",
      "      return ($jsonContent | ConvertFrom-Json -AsHashtable)                         ",
      "    } else {                                                                        ",
      "      $psObject = $jsonContent | ConvertFrom-Json                                   ",
      "      $hash = @{}                                                                   ",
      "      $psObject.psobject.properties | ForEach-Object {                              ",
      "        $hash[$_.Name] = $_.Value                                                   ",
      "      }                                                                             ",
      "      return $hash                                                                  ",
      "    }                                                                               ",
      "  } else {                                                                          ",
      "    return @{}                                                                      ",
      "  }                                                                                 ",
      "}                                                                                   ",
      "                                                                                    ",
      "# 2. 保存中心配置数据                                                               ",
      "function Save-BlacklistData {                                                       ",
      "  param([Parameter(Mandatory=$true)][hashtable]$Data)                               ",
      "  $Data | ConvertTo-Json -Depth 10 | Set-Content -Path $script:BlacklistFilePath    ",
      "}                                                                                   ",
      "                                                                                    ",
      "# 核心底层 API：通过隔离沙盒获取模块全量公开契约（绝对防污染）                      ",
      "function Get-ModuleCommandsByIsolatedImport {                                       ",
      "  param( [Parameter(Mandatory=$true)][string]$ModuleName)                           ",
      "                                                                                    ",
      "  $commandNames = @()                                                               ",
      "                                                                                    ",
      "  # 【唯一真理】彻底放弃 ListAvailable，所有模块均在隔离 Runspace 中真实加载提取    ",
      "  try {                                                                             ",
      "    $ps = [PowerShell]::Create()                                                    ",
      "                                                                                    ",
      "    $scriptBlock = {                                                                ",
      "      param($Name)                                                                  ",
      "      Import-Module -Name $Name -Force -ErrorAction Stop -wa SilentlyContinue       ",
      "                                                                                    ",
      "      Get-Command -Module $Name -CommandType function,cmdlet,alias -ea 0 |          ",
      "        Select-Object Name,ResolvedCommandName                                      ",
      "        # Select-Object -ExpandProperty Name                                        ",
      "    }                                                                               ",
      "                                                                                    ",
      "    $ps.AddScript($scriptBlock.ToString()) | Out-Null                               ",
      "    $ps.AddArgument($ModuleName) | Out-Null                                         ",
      "                                                                                    ",
      "    $result = $ps.Invoke()                                                          ",
      "    foreach ($item in $result) {                                                    ",
      "      $commandNames += $item                                                        ",
      "    }                                                                               ",
      "  } catch {                                                                         ",
      "    Write-Warning ('Failed to scan module [{0}] in isolated Runspace: {1}' -f       ",
      "                                             $ModuleName,$_.Exception.Message)      ",
      "    return @()                                                                      ",
      "  } finally {                                                                       ",
      "    if ($ps) { $ps.Dispose() }                                                      ",
      "  }                                                                                 ",
      "  # return ($commandNames | Select-Object -Unique)                                  ",
      "  return $result                                                                    ",
      "}                                                                                   ",
      "                                                                                    ",
      "# 4. 获取绝对干净的原生别名（在无任何第三方模块的沙盒中提取）                       ",
      "function Get-NativeAliasInIsolatedRunspace {                                        ",
      "  try {                                                                             ",
      "    $ps = [PowerShell]::Create()                                                    ",
      "    # 在绝对隔离的环境中获取别名，此时环境 100% 纯净                                ",
      "    $scriptBlock = {                                                                ",
      "      Get-Alias -ea 0 | Select-Object -ExpandProperty Name                          ",
      "    }                                                                               ",
      "    $ps.AddScript($scriptBlock.ToString()) | Out-Null                               ",
      "    $result = $ps.Invoke()                                                          ",
      "    return $result                                                                  ",
      "  } catch {                                                                         ",
      "    Write-Warning ('Failed to get native aliases in isolated Runspace: {0}' -f      ",
      "                                                     $_.Exception.Message )         ",
      "    return @()                                                                      ",
      "  } finally {                                                                       ",
      "    if ($ps) { $ps.Dispose() }                                                      ",
      "  }                                                                                 ",
      "}                                                                                   ",
      "                                                                                    ",
      "# 5. 业务 API：扫描模块，仅将【存在冲突】的别名注册到中心配置                       ",
      "function Register-ModuleAliasConflicts {                                            ",
      "  param( [Parameter(Mandatory=$true)][string]$ModuleName )                          ",
      "                                                                                    ",
      "  # 【核心复用】调用底层 API 获取模块全量命令                                       ",
      "  $commands = Get-ModuleCommandsByIsolatedImport -ModuleName $ModuleName            ",
      "                                                                                    ",
      "  if ($commands.Count -eq 0) {                                                      ",
      "    Write-Warning ('No exported commands found in module [{0}].' -f $ModuleName)    ",
      "    return                                                                          ",
      "  }                                                                                 ",
      "                                                                                    ",
      "  # 【终极基准】调用隔离 API 获取绝对干净的原生别名                                 ",
      "  $nativeAliasNames = Get-NativeAliasInIsolatedRunspace                             ",
      "                                                                                    ",
      "  # 读取当前中心配置                                                                ",
      "  $blacklist = Get-BlacklistData                                                    ",
      "                                                                                    ",
      "  if (-not $blacklist.ContainsKey($ModuleName)) {                                   ",
      "    $blacklist[$ModuleName] = @()                                                   ",
      "  }                                                                                 ",
      "                                                                                    ",
      "  # 【快照对比】记录初始大小，循环结束后通过差值计算新增数量                        ",
      "  $initialCount = $blacklist[$ModuleName].Count                                     ",
      "                                                                                    ",
      "  # 【交集过滤】精准找出同时存在于模块命令和原生别名中的项                          ",
      "  foreach ($cmd in $commands) {                                                     ",
      "    if ($nativeAliasNames -contains $cmd.name) {                                    ",
      "      if ($blacklist[$ModuleName] -notcontains $cmd.name) {                         ",
      "        $blacklist[$ModuleName] += $cmd                                             ",
      "      }                                                                             ",
      "    }                                                                               ",
      "  }                                                                                 ",
      "                                                                                    ",
      "  # 计算增量                                                                        ",
      "  $registeredCount = $blacklist[$ModuleName].Count - $initialCount                  ",
      "                                                                                    ",
      "  # 仅当有新冲突命令被注册时，才执行持久化写入                                      ",
      "  if ($registeredCount -gt 0) {                                                     ",
      "    Save-BlacklistData -Data $blacklist                                             ",
      "    $msg =                                                                          ",
      "      '[{0}] Registered {1} conflicting alias(es) from [{2}] to central config.' -f ",
      "        $script:CurrentModuleName, $registeredCount.ToString(), $ModuleName         ",
      "    Write-Host $msg -ForegroundColor Green                                          ",
      "  } else {                                                                          ",
      "    $msg = '[{0}] No conflicting aliases found in [{1}]. Config is up to date.' -f  ",
      "                                  $script:CurrentModuleName, $ModuleName            ",
      "    Write-Host $msg -ForegroundColor Cyan                                           ",
      "  }                                                                                 ",
      "  return                                                                            ",
      "}                                                                                   ",
      "                                                                                    ",
      "function Unregister-ModuleAliasConflicts {                                          ",
      "  param( [Parameter(Mandatory = $true)] [string]$ModuleName, [string[]]$Name)       ",
      "                                                                                    ",
      "  $blacklist = Get-BlacklistData                                                    ",
      "  if (-not $blacklist.ContainsKey($ModuleName)) {                                   ",
      "    Write-Warning (                                                                 ",
      "      'Module [{0}] does not exist in the conflicts list.' -f $ModuleName)          ",
      "    return                                                                          ",
      "  }                                                                                 ",
      "                                                                                    ",
      "  if (-not $Name) {                                                                 ",
      "    $removedCount = $blacklist[$ModuleName].Count                                   ",
      "    $blacklist.Remove($ModuleName)                                                  ",
      "    Save-BlacklistData -Data $blacklist                                             ",
      "    Write-Host (                                                                    ",
      "         'All {0} alias(es) removed. Module [{1}] has been completely cleared.' -f  ",
      "                    $removedCount, $ModuleName) -ForegroundColor Green              ",
      "  } else {                                                                          ",
      "    $initialCount = $blacklist[$ModuleName].Count                                   ",
      "    $blacklist[$ModuleName] = $blacklist[$ModuleName] |                             ",
      "                                   Where-Object { $_ -notin $Name }                 ",
      "    $removedCount = $initialCount - $blacklist[$ModuleName].Count                   ",
      "                                                                                    ",
      "    if ($removedCount -eq 0) {                                                      ",
      "      Write-Warning ('None of the specified aliases were found in module [{0}].' -f ",
      "                                                                $ModuleName)        ",
      "    } elseif ($removedCount -lt $Name.Count) {                                      ",
      "      Write-Warning ('Some specified aliases were not found in module [{0}].'    -f ",
      "                                                              $ModuleName)          ",
      "    }                                                                               ",
      "                                                                                    ",
      "    if ($blacklist[$ModuleName].Count -eq 0) {                                      ",
      "      $blacklist.Remove($ModuleName)                                                ",
      "    } else {                                                                        ",
      "      Save-BlacklistData -Data $blacklist                                           ",
      "    }                                                                               ",
      "                                                                                    ",
      "    Write-Host (                                                                    ",
      "      '{0} alias(es) removed from module [{1}].' -f $removedCount, $ModuleName      ",
      "    ) -ForegroundColor Green                                                        ",
      "  }                                                                                 ",
      "}                                                                                   ",
      "                                                                                    ",
      "# 8. Profile 中调用：强制执行别名黑名单，清理原生冲突（必须在 Profile 中执行）      ",
      "function Resolve-AliasConflicts {                                                   ",
      "  $blacklist = Get-BlacklistData                                                    ",
      "  $cleanedCount = 0                                                                 ",
      "                                                                                    ",
      "  $currentAliases = Get-Alias -ea 0                                                 ",
      "  foreach ($module in $blacklist.Keys) {                                            ",
      "    $commandsToClean = $blacklist[$module]                                          ",
      "    foreach ($cmd in $commandsToClean) {                                            ",
      "      $cmdName = $cmd.Name                                                          ",
      "      $cmdValue = $cmd.ResolvedCommandName  # only alias has ResolvedCommandName    ",
      "      $aliasInfo = $currentAliases | Where-Object { $_.Name -eq $cmdName }          ",
      "                                                                                    ",
      "      # 核心保护：如果原生别名存在，且它不属于任何已加载的模块，则强制删除          ",
      "      if ($aliasInfo -and -not $aliasInfo.Source) {                                 ",
      "        $aliasParams = @{                                                           ",
      "          Name  = $cmdName                                                          ",
      "          Value = $cmdValue                                                         ",
      "          Force = $true                                                             ",
      "        }                                                                           ",
      "        # 如果是 AllScope 别名，动态追加作用域参数                                  ",
      "        if ($aliasInfo.Options -match 'AllScope') {                                 ",
      "          $aliasParams['Scope'] = 'Global'                                          ",
      "          $aliasParams['Option'] = 'AllScope'                                       ",
      "        }                                                                           ",
      "        if ($cmdValue) {                                                            ",
      "          write-host ('Set Alias [{0}] to [{1}]' -f $cmdName,$cmdValue)             ",
      "          Set-Alias @aliasParams                                                    ",
      "        } else {                                                                    ",
      "          if ($aliasInfo.Options -match 'AllScope') {                               ",
      "            $aliasParams['Value'] = $module + '\\' + $cmdName                       ",
      "            write-host (('Set allScope Alias [{0}] point to func [{1}]. ' +         ",
      "                           'Allscope alias should be reset not delete.') -f         ",
      "                           $cmdName, $aliasParams['Value'])                         ",
      "            Set-Alias @aliasParams                                                  ",
      "          } else {                                                                  ",
      "            write-host (                                                            ",
      "             'Delete alias [{0}] for func [{0}] to take effective.' -f $cmdName)    ",
      "            remove-item -path Alias:$cmdName -Force                                 ",
      "          }                                                                         ",
      "        }                                                                           ",
      "        $cleanedCount++                                                             ",
      "      }                                                                             ",
      "    }                                                                               ",
      "  }                                                                                 ",
      "                                                                                    ",
      "  if ($cleanedCount -gt 0) {                                                        ",
      "    $msg = ('[{0}] Enforced blacklist: cleaned {1} native alias(es).' +             ",
      "           'Module auto-loading is now effective.') -f                              ",
      "           $script:CurrentModuleName,$cleanedCount                                  ",
      "    Write-Host $msg -ForegroundColor Yellow                                         ",
      "  }                                                                                 ",
      "}                                                                                   ",
      "                                                                                    ",
      "Export-ModuleMember -Function @(                                                    ",
      "  'Get-ModuleCommandsByIsolatedImport',                                             ",
      "  'Get-NativeAliasInIsolatedRunspace',                                              ",
      "  'Register-ModuleAliasConflicts',                                                  ",
      "  'Get-BlacklistData',                                                              ",
      "  'Unregister-ModuleAliasConflicts',                                                ",
      "  'Resolve-AliasConflicts'                                                          ",
      ")                                                                                   "
    ]
  }
}
