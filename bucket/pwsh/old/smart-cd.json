{
  "version": "1.0",
  "description": "CD Location History Tracker",
  "note" : "",
  "homepage": "https://github.com/owenstake/owen-bucket",
  "depends": ["zoxide"],
  "url": "https://github.com/owenstake/owen-bucket/releases/download/v1.0.0/Empty.txt",
  "hash": "2E1CFA82B035C26CBBBDAE632CEA070514EB8B773F616AAEAF668E2F0BE8F10D",
  "psmodule": { "name": "default" },
  "pre_install" : [
    "''                                                         ",
    "if ($null -ne $manifest.files) {                           ",
    "  foreach ($prop in $manifest.files.psobject.Properties) { ",
    "    if ($prop.Name -like 'default.*') {                    ",
    "      $filename = $prop.Name -replace 'default',$app       ",
    "    } else {                                               ",
    "      $filename = $prop.Name                               ", 
    "    }                                                      ",
    "    $fullpath = Join-Path $dir $filename                   ",
    "    info ('Writing to ' + $fullpath)                       ",
    "    Set-Content -Path $fullpath -Value $prop.value         ",
    "  }                                                        ",
    "}                                                          "
  ],
  "installer": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') {       ",
      "  $manifest.psmodule.name = $app                   ",
      "}                                                  "
    ]
  },
  "uninstaller": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') {       ",
      "  $manifest.psmodule.name = $app                   ",
      "}                                                  "
    ]
  },
  "files" : {
    "default.psm1" : [
      "$scriptFiles = Get-ChildItem -LiteralPath $PSScriptRoot -Filter '*.ps1' -ea 0",
      "                                                                             ",
      "foreach ($file in $scriptFiles) {                                            ",
      "  if ($file.Name -ne 'ignore-this.ps1') {                                    ",
      "    . $file.FullName                                                         ",
      "  }                                                                          ",
      "}                                                                            "
    ],
    "1-prompt-hook.ps1" : [
      "# 1. 初始化全域具名後置鉤子字典與上一次路徑快取（若尚未建立）                   ",
      "if ($null -eq $script:PromptPostHooks) {                                        ",
      "  $script:PromptPostHooks = [ordered]@{}                                        ",
      "}                                                                               ",
      "                                                                                ",
      "# Initialize hook.                                                              ",
      "$__prompt_hooked = (Get-Variable __prompt_hooked -ErrorAction Ignore -ValueOnly)",
      "if ($__prompt_hooked -ne 1) {                                                   ",
      "  $script:oldPath = $pwd                                                        ",
      "  $script:newPath = $pwd                                                        ",
      "  $__prompt_hooked = 1                                                          ",
      "  $__prompt_old = $function:prompt                                              ",
      "                                                                                ",
      "  function global:prompt {                                                      ",
      "    if ($null -ne $__prompt_old) {                                              ",
      "        & $__prompt_old                                                         ",
      "    }                                                                           ",
      "    $null = __prompt_hook                                                       ",
      "  }                                                                             ",
      "}                                                                               ",
      "                                                                                ",
      "function __prompt_hook() {                                                      ",
      "  # 4. 🏁 目錄變更成功後，依序動態輪詢觸發所有由 API 註冊的具名 Hooks           ",
      "  if ($PWD.Path -ne $script:newPath) {                                          ",
      "    $script:oldPath = $script:newPath                                           ",
      "    $script:newPath = $global:pwd                                               ",
      "    foreach ($hookName in $script:PromptPostHooks.Keys) {                       ",
      "      try {                                                                     ",
      "        $hook = $script:PromptPostHooks[$hookName]                              ",
      "        # 執行鉤子，並貼心將最新路徑與舊路徑當作參數向下傳遞                    ",
      "        & $hook -NewPath $script:newPath.Path -OldPath $script:oldPath          ",
      "      }                                                                         ",
      "      catch {                                                                   ",
      "        Write-Warning ('【cd-with-hook】Hook [$hookName] 異常: ' + $_)          ",
      "      }                                                                         ",
      "    }                                                                           ",
      "  }                                                                             ",
      "}                                                                               ",
      "                                                                                ",
      "# 3. 🏆 【Hook API】：動態「插上」外部連動功能，支援熱重載自動覆蓋更新          ",
      "function Add-PostPromptHook {                                                   ",
      "  [CmdletBinding()]                                                             ",
      "  param(                                                                        ",
      "    [Parameter(Mandatory = $true, Position = 0)][string]$Name,                  ",
      "    [Parameter(Mandatory = $true, Position = 1)][scriptblock]$ScriptBlock       ",
      "  )                                                                             ",
      "  $script:PromptPostHooks[$Name] = $ScriptBlock                                 ",
      "}                                                                               ",
      "                                                                                ",
      "# 4. 🏆 【Hook API】：動態「拔掉」外部連動功能                                  ",
      "function Remove-PostPromptHook {                                                ",
      "  [CmdletBinding()]                                                             ",
      "  param([Parameter(Mandatory = $true, Position = 0)][string]$Name)              ",
      "  if ($script:PromptPostHooks.Contains($Name)) {                                ",
      "    $script:PromptPostHooks.Remove($Name)                                       ",
      "  }                                                                             ",
      "}                                                                               ",
      "# 🏆 【Hook API】：查看当前已注册的 Prompt 钩子                                 ",
      "function Get-PostPromptHook {                                                   ",
      "  [CmdletBinding()]                                                             ",
      "  param(                                                                        ",
      "    [Parameter(Position = 0)][string]$Name                                      ",
      "  )                                                                             ",
      "  if ($Name) {                                                                  ",
      "    if ($script:PromptPostHooks.Contains($Name)) {                              ",
      "      return $script:PromptPostHooks[$Name]                                     ",
      "    } else {                                                                    ",
      "      Write-Warning ('Hook [{0}] not found.' -f $Name)                          ",
      "    }                                                                           ",
      "  } else {                                                                      ",
      "    return $script:PromptPostHooks                                              ",
      "  }                                                                             ",
      "}                                                                               ",
      "                                                                                ",
      "Export-ModuleMember -Function Add-PostPromptHook, Remove-PostPromptHook         "
    ],
    "cd-with-back.ps1" : [
      "# 2. 定義純 function cd。因為 $PROFILE 已提前刪除別名，此處直接全域生效           ",
      "function cd {                                                                     ",
      "  [CmdletBinding()]                                                               ",
      "  param([Parameter(ValueFromRemainingArguments=$true)]$Path)                      ",
      "                                                                                  ",
      "  # 紀錄跳轉前的舊路徑                                                            ",
      "  $curPwd = $PWD.Path                                                             ",
      "                                                                                  ",
      "  # 核心功能 1：安全邊界處理，若參數為空或只有空格，預設返回使用者家目錄          ",
      "  if ($null -eq $Path -or $Path.Count -eq 0 -or                                   ",
      "               [string]::IsNullOrWhiteSpace($Path)) {                             ",
      "    $targetPath = $env:USERPROFILE                                                ",
      "  } else {                                                                        ",
      "    # 平整化！將 List 陣列用空格黏合成一條純文字字串，完美支持帶有空格的路徑      ",
      "    $targetPath = $Path -join ' '                                                 ",
      "  }                                                                               ",
      "                                                                                  ",
      "  # 核心功能 2：一鍵返回上一個目錄 (cd -)                                         ",
      "  if ($targetPath -eq '-') {                                                      ",
      "    if ([string]::IsNullOrWhiteSpace($global:oldPWD)) {                           ",
      "      Write-Warning '【cd-with-back】目前沒有歷史紀錄！'                          ",
      "      return                                                                      ",
      "    }                                                                             ",
      "    # 將目標路徑強行替換為上次快取的路徑，並在畫面上印出來                        ",
      "    $targetPath = $global:oldPWD                                                  ",
      "  }                                                                               ",
      "                                                                                  ",
      "  # 3. 執行 100% 純微軟原生路徑跳轉                                               ",
      "  try {                                                                           ",
      "    # 使用 -LiteralPath 進行盲跑防錯，遇到名稱帶有中括號 [ ] 的資料夾也絕對不崩潰 ",
      "    Set-Location -LiteralPath $targetPath                                         ",
      "                                                                                  ",
      "    # 核心功能 3：跳轉成功後，更新「上一個目錄」的記憶體快取                      ",
      "    if ($curPwd -ne $PWD.Path) {                                                  ",
      "      $global:oldPWD = $curPwd                                                    ",
      "    }                                                                             ",
      "  }                                                                               ",
      "  catch {                                                                         ",
      "    Write-Error ('【cd-with-back】無法導航: ' + $_)                               ",
      "    return                                                                        ",
      "  }                                                                               ",
      "}                                                                                 ",
      "                                                                                  ",
      "Add-PostPromptHook -Name 'oldPwdCheck' -ScriptBlock {                             ",
      "  param($newPath, $oldPath)                                                       ",
      "  if ($global:oldpwd -ne $oldPath) {                                              ",
      "    # User use zoxide not cd, zoxide change directory without update $oldpwd      ",
      "    $global:oldpwd = $oldPath                                                     ",
      "  }                                                                               ",
      "}                                                                                 ",
      "Export-ModuleMember -Function cd                                                  "
    ],
    "d.ps1" : [
      "Function LocationHistoryListPush($loc=$pwd) {                          ",
      "  $loc = (Get-Item $loc).FullName                                      ",
      "  $LocationHistoryListMaxCount = 20                                    ",
      "  # Remove duplicat item                                               ",
      "  ForEach($l in $LocationHistoryList) {                                ",
      "    if ($l -eq $loc) {                                                 ",
      "      $LocationHistoryList.Remove($l)                                  ",
      "      break                                                            ",
      "    }                                                                  ",
      "  }                                                                    ",
      "  # Enqueue                                                            ",
      "  $LocationHistoryList.Insert(0, $loc)                                 ",
      "  # Dequeue if oversize                                                ",
      "  if ($LocationHistoryList.Count -gt $LocationHistoryListMaxCount) {   ",
      "    $LocationHistoryList.RemoveAt($LocationHistoryList.Count - 1)      ",
      "  }                                                                    ",
      "}                                                                      ",
      "Function d($index) {                                                   ",
      "  if ($index) {                                                        ",
      "    cd $LocationHistoryList[$index]                                    ",
      "  } else {                                                             ",
      "    $nl = [Environment]::NewLine                                       ",
      "    Write-Host ($nl + 'Location History List:' + $nl)                  ",
      "    For ($i=0; $i -le $LocationHistoryList.Count - 1; $i++) {          ",
      "      $p = $LocationHistoryList[$i]                                    ",
      "      Write-Host ([string]$i + [char]9 + $p)                           ",
      "    }                                                                  ",
      "  }                                                                    ",
      "}                                                                      ",
      "                                                                       ",
      "Add-PostPromptHook -Name 'HistoryTracker-handler' -ScriptBlock {       ",
      "  param($NewPath, $OldPath)                                            ",
      "  LocationHistoryListPush $NewPath                                     ",
      "}                                                                      ",
      "                                                                       ",
      "# init                                                                 ",
      "$LocationHistoryList = [System.Collections.Generic.List[object]]::new()",
      "LocationHistoryListPush                                                ",
      "                                                                       ",
      "Export-ModuleMember -Function d                                        "
    ],
    "zoxide-pwsh.ps1" : [
      "# zoxide init                                                                ",
      "$Env:_ZO_FZF_OPTS='--reverse --height 60%'                                   ",
      "                                                                             ",
      "# Initialize zoxide                                                          ",
      "Invoke-Expression (& { (zoxide init powershell --hook none | Out-String) })  ",
      "Function zc($p) {z $pwd $p}   # match the path in current dir                ",
      "Function zd {cd ~/Downloads }                                                ",
      "Function ze {zoxide edit }                                                   ",
      "Function zh {cd $Env:Home }                                                  ",
      "Function zr {cd ~/Desktop }                                                  ",
      "Function zw {cd $Env:weiyun }                                                ",
      "Function zx {cd $Env:xdg_config_home }                                       ",
      "                                                                             ",
      "Function zb($skipCurDir=$false) {                                            ",
      "  $markFiles = ('.root', '.git', '.svn', 'package.json')                     ",
      "  $curDir = $(Get-Item '.')                                                  ",
      "  if ($skipCurDir) {                                                         ",
      "    $prevDir = $curDir                                                       ",
      "    $curDir = $curDir.Parent                                                 ",
      "  }                                                                          ",
      "  # Iterating to find the root                                               ",
      "  while ($curDir) {                                                          ",
      "    $dirName = $curDir.FullName                                              ",
      "    ForEach($m in $markFiles) {                                              ",
      "      If (Test-Path (Join-Path $dirName $m)) {                               ",
      "        cd $dirName                                                          ",
      "        return                                                               ",
      "      }                                                                      ",
      "    }                                                                        ",
      "    $prevDir = $curDir                                                       ",
      "    $curDir = $curDir.Parent                                                 ",
      "  }                                                                          ",
      "  cd $prevDir   # cd to current disk root                                    ",
      "}                                                                            ",
      "Function zbb($p) {                                                           ",
      "  zb $true                                                                   ",
      "}                                                                            ",
      "                                                                             ",
      "Add-PostPromptHook -Name 'zoxide-handler' -ScriptBlock {                     ",
      "  param($NewPath, $OldPath)                                                  ",
      "  zoxide add '--' $NewPath                                                   ", 
      "}                                                                            ",
      "                                                                             ",
      "Export-ModuleMember -Function *                                              "
    ]
  }
}
