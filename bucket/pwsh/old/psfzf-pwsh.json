{
  "version": "1.0",
  "description": "Configuration for psfzf",
  "note" : "",
  "homepage": "https://github.com/owenstake/owen-bucket",
  "depends": ["psfzf"],
  "url": "https://github.com/owenstake/owen-bucket/releases/download/v1.0.0/Empty.txt",
  "hash": "2E1CFA82B035C26CBBBDAE632CEA070514EB8B773F616AAEAF668E2F0BE8F10D",
  "psmodule": { "name": "default" },
  "pre_install" : [
    "''                                                         ",
    "if ($null -ne $manifest.files) {                           ",
    "  foreach ($prop in $manifest.files.psobject.Properties) { ",
    "    if ($prop.Name -like 'default.*') {                    ",
    "      $filename = $prop.Name -replace 'default',$app       ",
    "    } else {                                               ",
    "      $filename = $prop.Name                               ", 
    "    }                                                      ",
    "    $fullpath = Join-Path $dir $filename                   ",
    "    info ('Writing to ' + $fullpath)                       ",
    "    $prop.Value = $prop.Value -replace '(?m)\\s+$', ''     ",
    "    Set-Content -Path $fullpath -Value $prop.value         ",
    "  }                                                        ",
    "}                                                          "
  ],
  "installer": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') { ",
      "  $manifest.psmodule.name = $app             ",
      "}                                            "
    ]
  },
  "uninstaller": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') { ",
      "  $manifest.psmodule.name = $app             ",
      "}                                            "
    ]
  },
  "files" : {
    "default.psm1" : [
      "# Env psfzf                                                                     ",
      "# Fzf is use cmd.exe as default shell if $env:shell or %SHELL% is not set.      ",
      "                                                                                ",
      "$env:FZF_CTRL_T_COMMAND='                                                       ",
      "  $InputEncoding = $OutputEncoding =                                            ",
	  	"  [Console]::OutputEncoding = [Console]::InputEncoding =                        ",
	  	"  [System.Text.Encoding]::utf8  # fix chinese garbled char                      ",
      "  fd --color always                                                             ",
      "'                                                                               ",
      "                                                                                ",
      "$fzfEzaOpt = 'eza --no-quotes --color=always ' +                                ",
      "                 '--sort new --reverse {0}{1}{0}' -f [char]34,'%cd%'            ",
      "                                                                                ",
      "$env:FZF_CTRL_T_OPTS='                                                          ",
      "  --multi --border --reverse --ansi --height 60%                                ",
      "  --prompt  {0}All> {0}                                                         ",
      "  --preview {0}(bat --color=always {{}} || eza {{}} -1 --color always) 2> nul{0}",
      "  --header  {0}CTRL-D: Dirs / CTRL-F: Files / CTRL-T: SortTime / CTRL-O: Open   ",
      "/ CTRL-Y: Copy File / CTRL-I: Copy FullPath {0}                                 ",
      "  --bind {1}ctrl-/:toggle-preview{1}                                            ",
      "  --bind {1}ctrl-d:change-prompt(Directories> )+reload(fd --type directory){1}  ",
      "  --bind {1}ctrl-f:change-prompt(Files> )+reload(fd --type file ){1}            ",
      "  --bind {1}ctrl-t:change-prompt(Sort by time> )+reload({2}){1}                 ",
      "  --bind {1}ctrl-o:execute-silent(pwsh -c Invoke-Item {0}{{}}{0} ){1}           ",
      "  --bind {1}ctrl-i:execute-silent(pwsh -c Set-Clipboard {0}%cd%/{{}}{0}){1}     ",
      "  --bind {1}ctrl-y:execute-silent(pwsh -c yww {0}{{}}{0}){1}                    ",
      "' -f [char]39,[char]34,$fzfEzaOpt                                               ",
      "                                                                                ",
      "Set-PsFzfOption -PSReadlineChordProvider 'Ctrl+t'                               ",
      "Set-PsFzfOption -PSReadlineChordReverseHistory 'Ctrl+r'                         ",
      "Set-PSFzfOption -EnableAliasFuzzyGitStatus    # fgs                             ",
      "Set-PSFzfOption -EnableAliasFuzzyKillProcess  # fkill                           ",
      "Set-PSFzfOption -EnableAliasFuzzyScoop                                          ",
      "                                                                                ",
      "Set-Alias -Name frg -Value 'Invoke-PsFzfRipgrep'                                ",
      "Set-Alias -Name fsc -Value 'Invoke-FuzzyScoop'                                  ",
      "                                                                                ",
      "Function gaf {                                                                  ",
      "    git add $(fgs)                                                              ",
      "}                                                                               ",
      "                                                                                ",
      "Function Invoke-FuzzyScoop {                                                                                     ",
      "  param(                                                                                                         ",
      "    [string]$subcommand = 'install',                                                                             ",
      "    [string]$subcommandflags = ''                                                                                ",
      "  )                                                                                                              ",
      "                                                                                                                 ",
      "  $result = $null                                                                                                ",
      "  $scoopDir = Split-Path (Split-Path (Get-Command scoop.ps1).Source -Parent) -Parent                             ",
      "  if ($scoopDir) {                                                                                               ",
      "    $apps = New-Object System.Collections.ArrayList                                                              ",
      "    Get-ChildItem (Join-Path $scoopDir buckets) | ForEach-Object {                                               ",
      "      $bucket = $_.Name                                                                                          ",
      "      Get-ChildItem (Join-Path $_.FullName bucket) -Recurse -File -Filter '*.json' | ForEach-Object {            ",
      "        $apps.Add((Join-Path $bucket $_.BaseName)) > $null                                                       ",
      "      }                                                                                                          ",
      "    }                                                                                                            ",
      "    $result = $apps | Invoke-Fzf -Multi -Header 'Scoop Applications' -Preview 'scoop info {}' -PreviewWindow wrap",
      "  }                                                                                                              ",
      "                                                                                  ",
      "  if ($null -ne $result) {                                                        ",
      "    # Invoke-Expression \"scoop $subcommand $($result -join ' ') $subcommandflags\" ",
      "    & scoop $subcommand $($result -join ' ') $subcommandflags                     ",
      "  }                                                                               ",
      "}                                                                                 ",
      "                                                                                  "
    ]
  }
}
