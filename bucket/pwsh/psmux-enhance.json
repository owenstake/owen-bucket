{
  "version": "1.0.0",
  "description": "Psmux Configuration",
  "homepage": "https://github.com/owenstake/owen-bucket",
  "url": "https://github.com/owenstake/owen-bucket/releases/download/v1.0.0/Empty.txt",
  "hash": "2E1CFA82B035C26CBBBDAE632CEA070514EB8B773F616AAEAF668E2F0BE8F10D",
  "pre_install" : [
    "''                                                           ",
    "if ($null -ne $manifest.files) {                             ",
    "  foreach ($prop in $manifest.files.psobject.Properties) {   ",
    "    if ($prop.Name -like 'default.*') {                      ",
    "      $filename = $prop.Name -replace 'default',$app         ",
    "    } else {                                                 ",
    "      $filename = $prop.Name                                 ", 
    "    }                                                        ",
    "    $fullpath = Join-Path $dir $filename                     ",
    "    info ('Writing to ' + $fullpath)                         ",
    "    $prop.Value = $prop.Value -replace '(?m)\\s+$', ''       ",
    "    Set-Content -Path $fullpath -Value $prop.value.trimEnd() ",
    "  }                                                          ",
    "}                                                            "
  ],
  "installer": {
    "script": [
      "''                                              ",
      "info 'Add hook to ~/.psmux.conf'                ",
      "$content = 'source-file {0}/psmux.conf' -f $dir ",
      "Set-Content -Path ~/.psmux.conf -Value $content "
    ]
  },
  "uninstaller": { "script": [ ] },
  "files" : {
    "psmux.conf" : [
      "# Set key mode                                                                                                            ",
      "set -g mode-keys vi  # For copy mode                                                                                      ",
      "set -g status-keys emacs   # Key bindings for the command prompt                                                          ",
      "                                                                                                                          ",
      "# key binding                                                                                                             ",
      "bind-key -r -T prefix S setw synchronize-panes \\; display-message 'synchronize-panes is now #{?pane_synchronized,on,off}'",
      "# bind-key -r -T root C-q send-keys 'TMOUT=0\\nEDITOR=vim\\n\\n\\n'                                                       ",
      "                                                                                                                          ",
      "# pane splitting '-' = 上下分屏（vertical）                                                                               ",
      "unbind-key -T prefix \"                                                                                                   ",
      "bind-key -T prefix - split-window -v                                                                                      ",
      "                                                                                                                          ",
      "# pane navigation  -  hjkl 切换窗格（Prefix + h/j/k/l）                                                                   ",
      "unbind-key -T prefix  l                                                                                                   ",
      "bind-key -T prefix h select-pane -L                                                                                       ",
      "bind-key -T prefix j select-pane -D                                                                                       ",
      "bind-key -T prefix k select-pane -U                                                                                       ",
      "bind-key -T prefix l select-pane -R                                                                                       ",
      "                                                                                                                          ",
      "# windows move                                                                                                            ",
      "# bind-key -r prefix < swap-window -t -1                                                                                  ",
      "# bind-key -r prefix > swap-window -t +1                                                                                  ",
      "                                                                                                                          ",
      "## --- Window navigation ---                                                                                              ",
      "# < and > to swap windows left/right (repeatable)                                                                         ",
      "bind-key -r '<' swap-window -t -1                                                                                         ",
      "bind-key -r '>' swap-window -t +1                                                                                         ",
      "                                                                                                                          ",
      "# windows navigation                                                                                                      ",
      "# [move-window fail](https://github.com/psmux/psmux/issues/602 )                                                          ",
      "# bind-key -r -T prefix H    swap-window -t +1 \\; previous-window  -- wait psmux fix                                     ",
      "# bind-key -r -T prefix L    swap-window -t -1 \\; next-window                                                            ",
      "bind-key -r -T prefix H    previous-window                                                                                ",
      "bind-key -r -T prefix L    next-window                                                                                    ",
      "bind-key -r -T prefix C-l  switch-client -l                                                                               ",
      "bind-key -r -T prefix Tab  last-window # switch to last windows                                                           ",
      "                                                                                                                          ",
      "# reload config file                                                                                                      ",
      "bind r source-file ~/.psmux.conf \\; display 'Reloaded Psmux Configuration!'                                              ",
      "                                                                                                                          ",
      "set -g default-shell 'pwsh.exe'                                                                                           ",
      "set -g paste-detection off # Disable paste detection so Ctrl+V reaches child apps like nvim                               ",
      "                                                                                                                          ",
      "# status bar setting                                                                                                      ",
      "set-window-option -g window-status-current-style bg=yellow                                                                ",
      "set -g window-status-last-style fg=yellow,bold                                                                            ",
      "set -g base-index 1   # windows number                                                                                    ",
      "setw -g pane-base-index 1                                                                                                 ",
      "                                                                                                                          ",
      "# For PSreadline                                                                                                          ",
      "set -g allow-predictions on                                                                                               ",
      "set -g prediction-dimming off                                                                                             ",
      "                                                                                                                          ",
      "# For nvim                                                                                                                ",
      "set -g allow-passthrough all                                                                                              "
    ],
  }
}
