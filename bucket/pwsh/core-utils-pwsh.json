{
  "version": "1.0",
  "description": "basic",
  "note" : "",
  "homepage": "https://github.com/owenstake/owen-bucket",
  "depends": ["neovim"],
  "url": "https://github.com/owenstake/owen-bucket/releases/download/v1.0.0/Empty.txt",
  "hash": "2E1CFA82B035C26CBBBDAE632CEA070514EB8B773F616AAEAF668E2F0BE8F10D",
  "psmodule": { "name": "default" },
  "pre_install" : [
    "''                                                         ",
    "if ($null -ne $manifest.files) {                           ",
    "  foreach ($prop in $manifest.files.psobject.Properties) { ",
    "    if ($prop.Name -like 'default.*') {                    ",
    "      $filename = $prop.Name -replace 'default',$app       ",
    "    } else {                                               ",
    "      $filename = $prop.Name                               ", 
    "    }                                                      ",
    "    $fullpath = Join-Path $dir $filename                   ",
    "    info ('Writing to ' + $fullpath)                       ",
    "    $prop.Value = $prop.Value -replace '(?m)\\s+$', ''     ",
    "    Set-Content -Path $fullpath -Value $prop.value         ",
    "  }                                                        ",
    "}                                                          "
  ],
  "installer": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') { ",
      "  $manifest.psmodule.name = $app             ",
      "}                                            "
    ]
  },
  "uninstaller": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') { ",
      "  $manifest.psmodule.name = $app             ",
      "}                                            "
    ]
  },
  "files" : {
    "default.psm1" : [
      "$scriptFiles = Get-ChildItem -LiteralPath $PSScriptRoot -Filter '*.ps1' -ea 0",
      "                                                                             ",
      "foreach ($file in $scriptFiles) {                                            ",
      "  # 🧼 排除主文件本身（若主文件不巧命名為 .ps1）或特定暫存檔                 ",
      "  if ($file.Name -ne 'ignore-this.ps1') {                                    ",
      "    # 0 毫秒解包 dot-sourcing，強制注入當前記憶體作用域                      ",
      "    . $file.FullName                                                         ",
      "  }                                                                          ",
      "}                                                                            "
    ],
    "misc.ps1" : [
      "$env:EDITOR = 'nvim'                                                             ",
      "                                                                                 ",
      "Set-Alias e exp                                                                  ",
      "Set-Alias df Get-Psdrive                                                         ",
      "Set-Alias dig Resolve-DnsName                                                    ",
      "#if ($PSVersionTable.PSVersion.Major -ge 7) {                                    ",
      "#  Set-Alias rp RealPath -force                                                  ",
      "#}                                                                               ",
      "Set-Alias v  nvim                                                                ",
      "Set-Alias vi nvim                                                                ",
      "Set-Alias wc measure-object                                                      ",
      "Set-Alias x  Extract                                                             ",
      "                                                                                 ",
      "function init-core() { del alias:cd -scope global}                               ",
      "                                                                                 ",
      "Function bg() {Start-Process -NoNewWindow @args}                                 ",
      "                                                                                 ",
      "Function RealPath() {                                                            ",
      "  (Get-Item @args).FullName                                                      ",
      "}                                                                                ",
      "                                                                                 ",
      "Function which($cmd) {                                                           ",
      "  $c = $(Get-Command $cmd)                                                       ",
      "  if ($c) {                                                                      ",
      "    Write-host ($c | out-string)                                                 ",
      "    Write-host $c.ScriptBlock                                                    ",
      "  }                                                                              ",
      "}                                                                                ",
      "                                                                                 ",
      "del alias:wget -ea 0                                                             ",
      "Function wget($uri, $file=$null) {                                               ",
      "  if (!$file) {                                                                  ",
      "    $file=$uri.split('/')[-1]                                                    ",
      "  }                                                                              ",
      "  Write-Host 'WGET: Saving as' $file                                             ",
      "  curl.exe -L -o $file $uri                                                      ",
      "}                                                                                ",
      "                                                                                 ",
      "function sshpass {                                                               ",
      "  param (                                                                        ",
      "    [Parameter(Mandatory=$true, position=0)][string]$p,                          ",
      "    [parameter(mandatory=$false, position=1,                                     ",
      "               ValueFromRemainingArguments=$true)]$Remaining                     ",
      "  )                                                                              ",
      "  [System.Windows.Forms.SendKeys]::SendWait($p+'{Enter}');                       ",
      "  Invoke-Expression $Remaining                                                   ",
      "}                                                                                ",
      "                                                                                 ",
      "filter Head($n=10) {                                                             ",
      "  if ($count++ -lt $n) {                                                         ",
      "    $_                                                                           ",
      "  }                                                                              ",
      "}                                                                                ",
      "                                                                                 ",
      "function Tail {                                                                  ",
      "  Param(                                                                         ",
      "    [int] $count = 10,                                                           ",
      "    [Parameter(ValueFromPipeline)] $InputObject                                  ",
      "  )                                                                              ",
      "  begin {                                                                        ",
      "    $queue = New-Object System.Collections.Queue                                 ",
      "    $overflowCount = $count * 2                                                  ",
      "  }                                                                              ",
      "  process {                                                                      ",
      "    $queue.enqueue($InputObject)                                                 ",
      "    if($queue.Count -gt $overflowCount ) {                                       ",
      "      while ($queue.Count -gt $count) { $queue.dequeue() | out-null }            ",
      "    }                                                                            ",
      "  }                                                                              ",
      "  end {                                                                          ",
      "    while ($queue.Count -gt $count) { $queue.dequeue() | out-null }              ",
      "    $queue                                                                       ",
      "  }                                                                              ",
      "}                                                                                ",
      "                                                                                 ",
      "del alias:ls -force -ea 0                                                        ",
      "Set-Alias -Name l -Value ll                                                      ",
      "function ls() {                                                                  ",
      "  eza --color always @args                                                       ",
      "}                                                                                ",
      "function ll() {                                                                  ",
      "  eza --color --long @args                                                       ",
      "}                                                                                ",
      "function lt() {                                                                  ",
      "  eza --color -snew --long @args                                                 ",
      "}                                                                                ",
      "function tree {                                                                  ",
      "  [CmdletBinding(PositionalBinding = $false)]                                    ",
      "  param(                                                                         ",
      "    [Parameter(Position = 0)]                                                    ",
      "    [int]$l,                                                                     ",
      "    [Parameter(ValueFromRemainingArguments = $true)]                             ",
      "    $RemainingArgs                                                               ",
      "  )                                                                              ",
      "  $ezaArgs = @('--color=always', '--tree')                                       ",
      "  if ($PSBoundParameters.ContainsKey('l')) {                                     ",
      "    $ezaArgs += '--level=' + $l                                                  ",
      "  }                                                                              ",
      "  if ($RemainingArgs) {                                                          ",
      "    $ezaArgs += $RemainingArgs                                                   ",
      "  }                                                                              ",
      "  eza.exe @ezaArgs                                                               ",
      "}                                                                                ",
      "                                                                                 ",
      "del alias:mv -force -ea 0                                                        ",
      "function mv {                                                                    ",
      "  # 1. 检查参数数量，至少需要2个（1个源 + 1个目标）                              ",
      "  if ($args.Count -lt 2) {                                                       ",
      "    Write-Error '用法: Move-Multi <源文件1> <源文件2> ... <目标路径>'            ",
      "    return                                                                       ",
      "  }                                                                              ",
      "                                                                                 ",
      "  # 2. 提取最后一个参数作为目标路径                                              ",
      "  $destination = $args[-1]                                                       ",
      "                                                                                 ",
      "  # 3. 提取除最后一个之外的所有参数作为源文件                                    ",
      "  $sources = $args[0..($args.Count - 2)]                                         ",
      "                                                                                 ",
      "  # 4. 遍历源文件并移动                                                          ",
      "  foreach ($source in $sources) {                                                ",
      "    if (Test-Path $source) {                                                     ",
      "      Move-Item -Path $source -Destination $destination -Force                   ",
      "      Write-Host ('已移动: {0} -> {1}' -f $source,$destination) -F green         ",
      "    } else {                                                                     ",
      "      Write-Warning '未找到文件，已跳过:' $source                                ",
      "    }                                                                            ",
      "  }                                                                              ",
      "}                                                                                ",
      "# Export-ModuleMember -Function *                                                ",
      "                                                                                 ",
      "Del alias:rm -force -ea 0                                                        ",
      "Function rm {                                                                    ",
      "  [CmdletBinding(DefaultParameterSetName='Path')]                                ",
      "  param(                                                                         ",
      "    [Parameter(ValueFromPipeline=$true, Position=0, ParameterSetName='Path')]    ",
      "    $Path,                                                                       ",
      "                                                                                 ",
      "    [Parameter(ValueFromRemainingArguments=$true)]                               ",
      "    $RemainingArgs                                                               ",
      "  )                                                                              ",
      "  process {                                                                      ",
      "    # 💡 核心机制：不管是单条输入，还是 ls | rm 这种长管道大批量流               ",
      "    # PowerShell 会在 process 块里自动挨个吐出来                                 ",
      "    if ($Path) {                                                                 ",
      "      # 如果传来的是对象，自动提取绝对路径 .FullName；如果是纯文本，直接使用原值 ",
      "      $targetPath = if ($Path.PSValue -and $Path.FullName) {                     ",
      "                       $Path.FullName } else { $Path.ToString() }                ",
      "                                                                                 ",
      "      # -LiteralPath，彻底免疫任何 [ ] 、( ) 或空格路径地雷！                    ",
      "      Remove-Item -LiteralPath $targetPath -Force -Recurse -Verbose -ea 0        ",
      "    }                                                                            ",
      "  }                                                                              ",
      "  end {                                                                          ",
      "    if ($RemainingArgs) {                                                        ",
      "      foreach ($argPath in $RemainingArgs) {                                     ",
      "        if ($argPath) {                                                          ",
      "          $targetArgPath = if ($argPath.PSValue -and $argPath.FullName) {        ",
      "                $argPath.FullName } else { $argPath.ToString() }                 ",
      "          Remove-Item -LiteralPath $targetArgPath -Force -Recurse -Verbose -ea 0 ",
      "        }                                                                        ",
      "      }                                                                          ",
      "    }                                                                            ",
      "  }                                                                              ",
      "}                                                                                ",
      "                                                                                 ",
      "function touch {                                                                 ",
      "  [CmdletBinding()]                                                              ",
      "  param(                                                                         ",
      "    [Parameter(Mandatory = $true, Position = 0, ValueFromPipeline = $true)]      ",
      "    [string[]]$Path                                                              ",
      "  )                                                                              ",
      "  process {                                                                      ",
      "    foreach ($item in $Path) {                                                   ",
      "      if (Test-Path -LiteralPath $item) {                                        ",
      "        # 檔案存在：0 毫秒穿透至 .NET 底層，強制重新整理檔案的最後寫入時間戳記   ",
      "        (Get-Item -LiteralPath $item).LastWriteTime = [System.DateTime]::Now     ",
      "      } else {                                                                   ",
      "        # 檔案不存在：安全建立全新的空檔案，-Force 確保路徑目錄相容              ",
      "        $null = New-Item -Path $item -ItemType 'File' -Force                     ",
      "      }                                                                          ",
      "    }                                                                            ",
      "  }                                                                              ",
      "}                                                                                ",
      "                                                                                 ",
      "Function exp($pathName='.') {                                                    ",
      "  $pathName = $pathName.Trim([char]34)                                           ",
      "  If ( !(Test-Path $pathName )) {                                                ",
      "    throw [System.IO.FileNotFoundException] ($pathName + ' no found')            ",
      "  }                                                                              ",
      "  $f = (get-item $pathName)                                                      ",
      "  $oldPath = $(get-location)                                                     ",
      "  if ( $f.Extension -eq '.lnk') {                                                ",
      "    write-host 'Open shortcut .lnk'                                              ",
      "    Set-location $f.Directory                                                    ",
      "    Start-Process $f                                                             ",
      "    set-location $oldPath                                                        ",
      "  } else {                                                                       ",
      "    explorer.exe $f                                                              ",
      "  }                                                                              ",
      "  # Explorer.exe is better than Invoke-Item                                      ",
      "  return                                                                         ",
      "}                                                                                ",
      "                                                                                 ",
      "function Get-ProfileTime {                                                                                           ",
      "  $noProfile  = (Measure-Command { powershell -NoProfile -Command 'exit' }).TotalMilliseconds                        ",
      "  $withProfile = (Measure-Command { powershell -Command 'exit' }).TotalMilliseconds                                  ",
      "  $cost = [math]::Round($withProfile - $noProfile, 1)                                                                ",
      "                                                                                                                     ",
      "  Write-Host 'Startup without profile: '+ ${noProfile}ms -ForegroundColor Cyan                                       ",
      "  Write-Host 'Startup with profile:    '+ ${withProfile}ms -ForegroundColor Cyan                                     ",
      "  Write-Host 'Profile overhead:        '+ ${cost}ms -ForegroundColor $(if ($cost -gt 500) { 'Red' } else { 'Green' })",
      "}                                                                                                                    ",
      "                                                                                                                     "
    ],
    "envvar.ps1" : [
      "                                                                      ",
      "function env { Get-ChildItem Env: }                                   ", 
      "                                                                      ",
      "Function Set-EnvVar($envName, $value, $option) {                      ",
      "  $envFullName = 'env:' + $envName                                    ",
      "  # change backslash to slash                                         ",
      "  $value = $value -replace [regex]::Escape([char]92),'/'              ",
      "  if ($envVar = Get-ChildItem -Path $envFullName -ea 0) {             ",
      "    if ($envVar.Value -eq $value) {                                   ",
      "      Write-Host ('Env:{0} already set to {1}' -f $envName,$value)    ",
      "      if ($option -eq '-f') {                                         ",
      "        Write-Warning 'Force set env'                                 ",
      "      } else {                                                        ",
      "        return                                                        ",
      "      }                                                               ",
      "    }                                                                 ",
      "  }                                                                   ",
      "  # Do it when env is empty or need overwritten                       ",
      "  Set-Item -Path $envFullName -Value $value                           ",
      "  [Environment]::SetEnvironmentVariable($envName, $value, 'User')     ",
      "  Write-Host ('Env:{0} set to {1}' -f $envName,$value)                ",
      "  return                                                              ",
      "}                                                                     ",
      "                                                                      ",
      "Function Remove-EnvVar($envName) {                                    ",
      "  $envFullName = 'env:' + $envName                                    ",
      "  Set-Item -Path $envFullName -Value $null                            ",
      "  [Environment]::SetEnvironmentVariable($envName, $null, 'User')      ",
      "  return                                                              ",
      "}                                                                     ",
      "                                                                      ",
      "Function Get-EnvVar($envName) {                                       ",
      "  $envFullName = 'env:' + $envName                                    ",
      "  [Environment]::GetEnvironmentVariable($envName, 'User')             ",
      "  return                                                              ",
      "}                                                                     ",
      "                                                                      "
    ]
  }
}
