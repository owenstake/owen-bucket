      "Del alias:rm -force -ea 0                                                        ",
      "function rm {                                                                    ",
      "  [CmdletBinding()]                                                              ",
      "  param(                                                                         ",
      "    [Parameter(ValueFromPipeline = $true, Position = 0)]                         ",
      "    $Path                                                                        ",
      "  )                                                                              ",
      "                                                                                 ",
      "  process {                                                                      ",
      "    if (-not $Path) { return }                                                   ",
      "                                                                                 ",
      "    $target = if ($Path.FullName) {                                              ",
      "      $Path.FullName                                                             ",
      "    } else {                                                                     ",
      "      $Path.ToString()                                                           ",
      "    }                                                                            ",
      "                                                                                 ",
      "    # 包含通配符时用 -Path，否则用 -LiteralPath                                  ",
      "    if ($target -match '[\\*\\?\\[\\]]') {                                       ",
      "      Remove-Item -Path $target -Force -Recurse -Verbose -ea 0                   ",
      "    } else {                                                                     ",
      "      Remove-Item -LiteralPath $target -Force -Recurse -Verbose -ea 0            ",
      "    }                                                                            ",
      "  }                                                                              ",
      "}                                                                                ",
