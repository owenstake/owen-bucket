      "function which {                                                                 ",
      "  param(                                                                         ",
      "    [Parameter(Mandatory=$true)]                                                 ",
      "    [string]$cmd                                                                 ",
      "  )                                                                              ",
      "                                                                                 ",
      "  # 1. 临时禁用模块自动加载，防止 Get-Command 触发后台模块加载                   ",
      "  $oldPref = $PSModuleAutoLoadingPreference                                      ",
      "  $PSModuleAutoLoadingPreference = 'None'                                        ",
      "                                                                                 ",
      "  try {                                                                          ",
      "    # 2. 获取命令信息，忽略错误以避免抛出异常 get-command 会触发模块加载         ",
      "    $c = Get-Command -Name $cmd -ErrorAction SilentlyContinue                    ",
      "                                                                                 ",
      "    if ($c) {                                                                    ",
      "      # 3. 输出命令的元数据表格                                                  ",
      "      Write-Host ($c | Out-String)                                               ",
      "                                                                                 ",
      "      # 4. 仅当命令是脚本/函数时，才尝试输出其脚本块                             ",
      "      # 避免对 Alias 或 Cmdlet 输出空内容                                        ",
      "      if ($c.CommandType -eq 'Function' -and $c.ScriptBlock) {                   ",
      "        Write-Host $c.ScriptBlock                                                ",
      "      }                                                                          ",
      "    } else {                                                                     ",
      "      Write-Warning ($cmd + ' not found.')                                       ",
      "    }                                                                            ",
      "  } finally {                                                                    ",
      "    # 5. 使用 finally 块确保无论是否发生异常，都能恢复原始偏好设置               ",
      "    $PSModuleAutoLoadingPreference = $oldPref                                    ",
      "  }                                                                              ",
      "}                                                                                ",
