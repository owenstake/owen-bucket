{
  "version": "1.0.1",
  "description": "CD Location History Tracker",
  "note" : "",
  "homepage": "https://github.com/owenstake/owen-bucket",
  "depends": ["zoxide"],
  "url": "https://github.com/owenstake/owen-bucket/releases/download/v1.0.0/Empty.txt",
  "hash": "2E1CFA82B035C26CBBBDAE632CEA070514EB8B773F616AAEAF668E2F0BE8F10D",
  "psmodule": { "name": "default" },
  "persist" : ["zoxide-data"],
  "pre_install" : [
    "''                                                           ",
    "if ($null -ne $manifest.files) {                             ",
    "  foreach ($prop in $manifest.files.psobject.Properties) {   ",
    "    if ($prop.Name -like 'default.*') {                      ",
    "      $filename = $prop.Name -replace 'default',$app         ",
    "    } else {                                                 ",
    "      $filename = $prop.Name                                 ", 
    "    }                                                        ",
    "    $fullpath = Join-Path $dir $filename                     ",
    "    info ('Writing to ' + $fullpath)                         ",
    "    $prop.Value = $prop.Value -replace '(?m)\\s+$', ''       ",
    "    Set-Content -Path $fullpath -Value $prop.value.trimEnd() ",
    "  }                                                          ",
    "}                                                            "
  ],
  "installer": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') { ",
      "  $manifest.psmodule.name = $app             ",
      "}                                            "
    ]
  },
  "post_install" : [
    "''                                 ",
    "Build-ModuleManifest $app $dir     ",
    "Register-ModuleAliasConflicts $app "
  ],
  "uninstaller": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') { ",
      "  $manifest.psmodule.name = $app             ",
      "}                                            ",
      "Unregister-ModuleAliasConflicts $app         ",
      "remove-module $app -ea 0                     "
    ]
  },
  "files" : {
    "default.psm1" : [
      "$scriptFiles = Get-ChildItem -LiteralPath $PSScriptRoot -Filter '*.ps1' -ea 0    ",
      "                                                                                 ",
      "foreach ($file in $scriptFiles) {                                                ",
      "  if ($file.Name -ne 'ignore-this.ps1') {                                        ",
      "    . $file.FullName                                                             ",
      "  }                                                                              ",
      "}                                                                                ",
      "  # 模块卸载时的清理逻辑                                                         ",
      "$ExecutionContext.SessionState.Module.OnRemove = {                               ",
      "  Write-Verbose 'On remove start'                                                ",
      "                                                                                 ",
      "  # 3. 归还原始的 prompt 函数（核心修复）                                        ",
      "  if ($null -ne $script:__prompt_old) {                                          ",
      "    # 将备份的原始 ScriptBlock 重新定义为全局 prompt 函数                        ",
      "    Set-Item -Path Function:global:prompt -Value $script:__prompt_old -Force     ",
      "                                                                                 ",
      "    # 清理备份变量                                                               ",
      "    # Remove-Variable -Name '__prompt_old' -Scope Global -Force -ea 0            ",
      "  }                                                                              ",
      "  Write-Verbose 'On remove end'                                                  ",
      "}                                                                                "
    ],
    "1-prompt-hook.ps1" : [
      "# Initialize hook.                                                              ",
      "if ($null -eq $script:PromptPostHooks) {                                        ",
      "  $script:PromptPostHooks = [ordered]@{}                                        ",
      "}                                                                               ",
      "                                                                                ",
      "if ($function:prompt | select-string __prompt_old) {                            ",
      "  $script:__prompt_hooked = 1                                                   ",
      "  Write-Verbose 'hook has set'                                                  ",
      "} else {                                                                        ",
      "  Write-Verbose 'hook not set'                                                  ",
      "}                                                                               ",
      "if ($script:__prompt_hooked -ne 1) {                                            ",
      "  $script:oldPath = $pwd                                                        ",
      "  $script:newPath = $pwd                                                        ",
      "  $script:__prompt_hooked = 1                                                   ",
      "  $script:__prompt_old = $function:prompt                                       ",
      "  function global:prompt {                                                      ",
      "    if ($null -ne $script:__prompt_old) {                                       ",
      "        & $script:__prompt_old                                                  ",
      "    }                                                                           ",
      "    $null = __prompt_hook                                                       ",
      "  }                                                                             ",
      "}                                                                               ",
      "                                                                                ",
      "function script:__prompt_hook {                                                 ",
      "  # 4. 🏁 目錄變更成功後，依序動態輪詢觸發所有由 API 註冊的具名 Hooks           ",
      "  if ($PWD.Path -ne $script:newPath) {                                          ",
      "    $script:oldPath = $script:newPath                                           ",
      "    $script:newPath = $global:pwd                                               ",
      "    foreach ($hookName in $script:PromptPostHooks.Keys) {                       ",
      "      try {                                                                     ",
      "        $hook = $script:PromptPostHooks[$hookName]                              ",
      "        # 執行鉤子，並貼心將最新路徑與舊路徑當作參數向下傳遞                    ",
      "        & $hook -NewPath $script:newPath.Path -OldPath $script:oldPath          ",
      "      }                                                                         ",
      "      catch {                                                                   ",
      "        Write-Warning ('【cd-with-hook】Hook [$hookName] 異常: ' + $_)          ",
      "      }                                                                         ",
      "    }                                                                           ",
      "  }                                                                             ",
      "}                                                                               ",
      "                                                                                ",
      "# 3. 🏆 【Hook API】：動態「插上」外部連動功能，支援熱重載自動覆蓋更新          ",
      "function Add-PostPromptHook {                                                   ",
      "  [CmdletBinding()]                                                             ",
      "  param(                                                                        ",
      "    [Parameter(Mandatory = $true, Position = 0)][string]$Name,                  ",
      "    [Parameter(Mandatory = $true, Position = 1)][scriptblock]$ScriptBlock       ",
      "  )                                                                             ",
      "  $script:PromptPostHooks[$Name] = $ScriptBlock                                 ",
      "}                                                                               ",
      "                                                                                ",
      "# 4. 🏆 【Hook API】：動態「拔掉」外部連動功能                                  ",
      "function Remove-PostPromptHook {                                                ",
      "  [CmdletBinding()]                                                             ",
      "  param([Parameter(Mandatory = $true, Position = 0)][string]$Name)              ",
      "  if ($script:PromptPostHooks.Contains($Name)) {                                ",
      "    $script:PromptPostHooks.Remove($Name)                                       ",
      "  }                                                                             ",
      "}                                                                               ",
      "# 🏆 【Hook API】：查看当前已注册的 Prompt 钩子                                 ",
      "function Get-PostPromptHook {                                                   ",
      "  [CmdletBinding()]                                                             ",
      "  param(                                                                        ",
      "    [Parameter(Position = 0)][string]$Name                                      ",
      "  )                                                                             ",
      "  if ($Name) {                                                                  ",
      "    if ($script:PromptPostHooks.Contains($Name)) {                              ",
      "      return $script:PromptPostHooks[$Name]                                     ",
      "    } else {                                                                    ",
      "      Write-Warning ('Hook [{0}] not found.' -f $Name)                          ",
      "    }                                                                           ",
      "  } else {                                                                      ",
      "    return $script:PromptPostHooks                                              ",
      "  }                                                                             ",
      "}                                                                               ",
      "                                                                                ",
      "# Export-ModuleMember -Function Add-PostPromptHook, Remove-PostPromptHook       "
    ],
    "cd-with-back.ps1" : [
      "$moduleName = Split-Path -Path $PSScriptRoot -Leaf                                ",
      "                                                                                  ",
      "$script:KnownFolder = (                                                           ",
      "    'Desktop', 'Documents', 'Downloads', 'Music',                               ",
      "    'Pictures', 'Videos', 'RoamingAppData', 'LocalAppData',                     ",
      "    'LocalAppDataLow', 'StartMenu', 'Programs', 'Startup',                      ",
      "    'Templates', 'Favorites', 'SendTo', 'Recent',                               ",
      "    'Cookies', 'InternetCache', 'History', 'SavedGames',                        ",
      "    'Contacts', 'Links', 'SearchHome', 'Profile'                                ",
      "  )                                                                            ",
      "                                                                                  ",
      "$script:AliasMap = @{                                                             ",
      "    # 核心个人文件夹 (最常见的重定向目标)                                         ",
      "    'Documents'      = 'Personal'                                                 ",
      "    'Music'          = 'My Music'                                                 ",
      "    'Pictures'       = 'My Pictures'                                              ",
      "    'Videos'         = 'My Video'                                                 ",
      "                                                                                  ",
      "    # 应用程序数据与缓存                                                          ",
      "    'RoamingAppData' = 'AppData'       # 对应 AppData/Roaming                     ",
      "    'LocalAppData'   = 'Local AppData' # 对应 AppData/Local                       ",
      "                                                                                  ",
      "    # 系统功能与开始菜单相关                                                      ",
      "    'Desktop'        = 'Desktop'       # 桌面                                     ",
      "    'StartMenu'      = 'Start Menu'    # 开始菜单                                 ",
      "    'Programs'       = 'Programs'      # 开始菜单中的“程序”列表                   ",
      "    'Startup'        = 'Startup'       # 启动文件夹                               ",
      "    'SendTo'         = 'SendTo'        # 发送到                                   ",
      "    'Recent'         = 'Recent'        # 最近使用的文档                           ",
      "    'Favorites'      = 'Favorites'     # 收藏夹                                   ",
      "    'Templates'      = 'Templates'     # 文档模板                                 ",
      "                                                                                  ",
      "    # 网络与打印机 (较少用于重定向，但存在于表中)                                 ",
      "    'NetHood'        = 'NetHood'       # 网上邻居                                 ",
      "    'PrintHood'      = 'PrintHood'     # 打印机连接                               ",
      "}                                                                                 ",
      "                                                                                  ",
      "# For explicit import-module not autoload                                         ",
      "Set-Alias cd invoke-cdwithBack -Force -Scope Global -Option AllScope              ",
      "                                                                                  ",
      "function .. { cd .. }                                                             ",
      "                                                                                  ",
      "function ce {                                                                     ",
      "  [CmdletBinding()]                                                               ",
      "  param(                                                                          ",
      "    [Parameter(ValueFromRemainingArguments=$true)]                                ",
      "    [ArgumentCompleter({                                                          ",
      "      param( $commandName, $parameterName, $wordToComplete,                       ",
      "             $commandAst, $fakeBoundParameters )                                  ",
      "                                                                                  ",
      "      $envName = Get-ChildItem env: -Name                                         ",
      "      $envName | Where-Object { $_ -like ($wordToComplete + '*') } |              ",
      "        ForEach-Object {                                                          ",
      "          [System.Management.Automation.CompletionResult]::new(                   ",
      "            $_, $_, 'ParameterValue', $_                                          ",
      "          )                                                                       ",
      "        }                                                                         ",
      "    })]                                                                           ",
      "    $envName                                                                      ",
      "  )                                                                               ",
      "                                                                                  ",
      "  $e = 'env:' + $envName                                                          ",
      "  if (!(test-path $e)) { write-warn ($e + 'not exists'); return}                  ",
      "  $p = (get-item $e).value                                                        ",
      "  invoke-cdwithBack $p                                                            ",
      "  return                                                                          ",
      "}                                                                                 ",
      "                                                                                  ",
      "function cs {                                                                     ",
      "  [CmdletBinding()]                                                               ",
      "  Param(                                                                          ",
      "    [ValidateSet(                                                                 ",
      "      'Desktop', 'Documents', 'Downloads', 'Music',                               ",
      "      'Pictures', 'Videos', 'RoamingAppData', 'LocalAppData',                     ",
      "      'LocalAppDataLow', 'StartMenu', 'Programs', 'Startup',                      ",
      "      'Templates', 'Favorites', 'SendTo', 'Recent',                               ",
      "      'Cookies', 'History', 'SavedGames',                                         ",
      "      'Contacts', 'Links', 'SearchHome', 'Profile'                                ",
      "    )]                                                                            ",
      "    [string]$KnownFolder                                                          ",
      "  )                                                                               ",
      "                                                                                  ",
      "  $alias = $script:AliasMap[$KnownFolder]                                         ",
      "  if(-not $alias) {$alias = $KnownFolder}                                         ",
      "                                                                                  ",
      "  # shell:folder                                                                  ",
      "  $shell = New-Object -ComObject Shell.Application                                ",
      "  $folder = $shell.NameSpace('shell:' + $alias)                                   ",
      "  if ($null -eq $folder) {                                                        ",
      "    $e = 'Invalid shell folder: ' + $pathName                                     ",
      "    throw [System.IO.DirectoryNotFoundException] ($e)                             ",
      "  }                                                                               ",
      "  cd $folder.Self.Path                                                            ",
      "  return                                                                          ",
      "}                                                                                 ",
      "                                                                                  ",
      "# function cd {                                                                   ",
      "function invoke-cdwithBack {                                                      ",
      "  [CmdletBinding()]                                                               ",
      "  param(                                                                          ",
      "    [Parameter(ValueFromRemainingArguments=$true)]                                ",
      "    $Path                                                                         ",
      "  )                                                                               ",
      "                                                                                  ",
      "  # 紀錄跳轉前的舊路徑                                                            ",
      "  $curPwd = $PWD.Path                                                             ",
      "                                                                                  ",
      "  # 核心功能 1：安全邊界處理，若參數為空或只有空格，預設返回使用者家目錄          ",
      "  if ($null -eq $Path -or $Path.Count -eq 0 -or                                   ",
      "               [string]::IsNullOrWhiteSpace($Path)) {                             ",
      "    $targetPath = if ($env:home) {$env:home} else {$env:userprofile}              ",
      "  } else {                                                                        ",
      "    # 平整化！將 List 陣列用空格黏合成一條純文字字串，完美支持帶有空格的路徑      ",
      "    $targetPath = $Path -join ' '                                                 ",
      "  }                                                                               ",
      "                                                                                  ",
      "  # 核心功能 2：一鍵返回上一個目錄 (cd -)                                         ",
      "  if ($targetPath -eq '-') {                                                      ",
      "    if ([string]::IsNullOrWhiteSpace($global:oldPWD)) {                           ",
      "      Write-Warning '【cd-with-back】目前沒有歷史紀錄！'                          ",
      "      return                                                                      ",
      "    }                                                                             ",
      "    # 將目標路徑強行替換為上次快取的路徑，並在畫面上印出來                        ",
      "    $targetPath = $global:oldPWD                                                  ",
      "  }                                                                               ",
      "                                                                                  ",
      "  # shell:folder                                                                  ",
      "  if ($targetPath -like 'shell:*') {                                              ",
      "    $shell = New-Object -ComObject Shell.Application                              ",
      "    $folder = $shell.NameSpace($targetPath)                                       ",
      "    if ($null -eq $folder) {                                                      ",
      "      $e = 'Invalid shell folder: ' + $pathName                                   ",
      "      throw [System.IO.DirectoryNotFoundException] ($e)                           ",
      "    }                                                                             ",
      "    $targetPath = $folder.Self.Path                                               ",
      "  }                                                                               ",
      "                                                                                  ",
      "  if (test-path -Path $targetPath -PathType Leaf) {                               ",
      "    $targetPath = Join-Path $targetPath ..                                        ",
      "  }                                                                               ",
      "                                                                                  ",
      "  # 3. 執行 100% 純微軟原生路徑跳轉                                               ",
      "  try {                                                                           ",
      "    # 使用 -LiteralPath 進行盲跑防錯，遇到名稱帶有中括號 [ ] 的資料夾也絕對不崩潰 ",
      "    Set-Location -LiteralPath $targetPath                                         ",
      "                                                                                  ",
      "    # 核心功能 3：跳轉成功後，更新「上一個目錄」的記憶體快取                      ",
      "    if ($curPwd -ne $PWD.Path) {                                                  ",
      "      $global:oldPWD = $curPwd                                                    ",
      "    }                                                                             ",
      "  }                                                                               ",
      "  catch {                                                                         ",
      "    Write-Error ('【cd-with-back】無法導航: ' + $_)                               ",
      "    return                                                                        ",
      "  }                                                                               ",
      "}                                                                                 ",
      "                                                                                  ",
      "Add-PostPromptHook -Name 'OldPwdCheck' -ScriptBlock {                             ",
      "  param($newPath, $oldPath)                                                       ",
      "  if ($global:oldpwd -ne $oldPath) {                                              ",
      "    # User use zoxide not cd, zoxide change directory without update $oldpwd      ",
      "    $global:oldpwd = $oldPath                                                     ",
      "  }                                                                               ",
      "}                                                                                 ",
      "# Export-ModuleMember -Function cd                                                "
    ],
    "d.ps1" : [
      "Function script:__LocationHistoryListPush($loc=$pwd) {                 ",
      "  $loc = (Get-Item $loc -force).FullName                               ",
      "  $LocationHistoryListMaxCount = 20                                    ",
      "  # Remove duplicat item                                               ",
      "  ForEach($l in $LocationHistoryList) {                                ",
      "    if ($l -eq $loc) {                                                 ",
      "      $LocationHistoryList.Remove($l)                                  ",
      "      break                                                            ",
      "    }                                                                  ",
      "  }                                                                    ",
      "  # Enqueue                                                            ",
      "  $LocationHistoryList.Insert(0, $loc)                                 ",
      "  # Dequeue if oversize                                                ",
      "  if ($LocationHistoryList.Count -gt $LocationHistoryListMaxCount) {   ",
      "    $LocationHistoryList.RemoveAt($LocationHistoryList.Count - 1)      ",
      "  }                                                                    ",
      "}                                                                      ",
      "Function d($index) {                                                   ",
      "  if ($index) {                                                        ",
      "    cd $LocationHistoryList[$index]                                    ",
      "  } else {                                                             ",
      "    $nl = [Environment]::NewLine                                       ",
      "    Write-Host ($nl + 'Location History List:' + $nl)                  ",
      "    For ($i=0; $i -le $LocationHistoryList.Count - 1; $i++) {          ",
      "      $p = $LocationHistoryList[$i]                                    ",
      "      Write-Host ([string]$i + [char]9 + $p)                           ",
      "    }                                                                  ",
      "  }                                                                    ",
      "}                                                                      ",
      "                                                                       ",
      "Add-PostPromptHook -Name 'HistoryTracker-handler' -ScriptBlock {       ",
      "  param($NewPath, $OldPath)                                            ",
      "  script:__LocationHistoryListPush $NewPath                            ",
      "}                                                                      ",
      "                                                                       ",
      "# init                                                                 ",
      "$LocationHistoryList = [System.Collections.Generic.List[object]]::new()",
      "script:__LocationHistoryListPush                                       ",
      "                                                                       ",
      "# Export-ModuleMember -Function d                                      "
    ],
    "zoxide-config.ps1" : [
      "# zoxide init                                                                         ",
      "$Env:_ZO_FZF_OPTS='--reverse --height 60%'                                            ",
      "if ($env:xdg_data_home) {                                                             ",
      "  $env:_ZO_DATA_DIR = Join-Path $env:xdg_data_home zoxide                             ",
      "} else {                                                                              ",
      "  $env:_ZO_DATA_DIR = $PSScriptRoot + '/../zoxide-data'                               ",
      "}                                                                                     ",
      "                                                                                      ",
      "# Initialize zoxide                                                                   ",
      "# Invoke-Expression (& { (zoxide init powershell --no-cmd --hook none | Out-String) })",
      "                                                                                      ",
      "if (Get-Command zoxide -ErrorAction SilentlyContinue) {                               ",
      "  # 1. 获取 zoxide 生成的初始化脚本                                                   ",
      "  $initScript = & zoxide init powershell --no-cmd --hook pwd | Out-String             ",
      "                                                                                      ",
      "  # 2. 【核心】：在内存中将所有的 'global:' 替换为 'script:'                          ",
      "  # 这样它生成的函数就会老老实实待在模块的私有作用域里                                ",
      "  $safeInitScript = $initScript -replace 'function global:', 'function script:'       ",
      "                                                                                      ",
      "  # 3. 在当前模块作用域中安全执行                                                     ",
      "  . ([ScriptBlock]::Create($safeInitScript))                                          ",
      "}                                                                                     ",
      "                                                                                      ",
      "Function z  {__zoxide_z @args }                                                       ",
      "Function zi {__zoxide_zi @args }                                                      ",
      "Function zc($p) {z $pwd $p}   # match the path in current dir                         ",
      "Function ze {zoxide edit }                                                            ",
      "Function zh {cd $Env:Home }                                                           ",
      "Function zw {cd $Env:weiyun }                                                         ",
      "Function zx {cd $Env:xdg_config_home }                                                ",
      "                                                                                      ",
      "Function zd {                                                                         ",
      "  cd (New-Object -ComObject Shell.Application).NameSpace('shell:Downloads').Self.Path ",
      "}                                                                                     ",
      "Function zr {                                                                         ",
      "  cd (New-Object -ComObject Shell.Application).NameSpace('shell:Desktop').Self.Path   ",
      "}                                                                                     ",
      "                                                                                      ",
      "Function zb($skipCurDir=$false) {                                                     ",
      "  $markFiles = ('.root', '.git', '.svn', 'package.json')                              ",
      "  $curDir = $(Get-Item '.' -force)                                                    ",
      "  if ($skipCurDir) {                                                                  ",
      "    $prevDir = $curDir                                                                ",
      "    $curDir = $curDir.Parent                                                          ",
      "  }                                                                                   ",
      "  # Iterating to find the root                                                        ",
      "  while ($curDir) {                                                                   ",
      "    $dirName = $curDir.FullName                                                       ",
      "    ForEach($m in $markFiles) {                                                       ",
      "      If (Test-Path (Join-Path $dirName $m)) {                                        ",
      "        cd $dirName                                                                   ",
      "        return                                                                        ",
      "      }                                                                               ",
      "    }                                                                                 ",
      "    $prevDir = $curDir                                                                ",
      "    $curDir = $curDir.Parent                                                          ",
      "  }                                                                                   ",
      "  cd $prevDir   # cd to current disk root                                             ",
      "}                                                                                     ",
      "Function zbb($p) {                                                                    ",
      "  zb $true                                                                            ",
      "}                                                                                     ",
      "                                                                                      ",
      "Add-PostPromptHook -Name 'zoxide-handler' -ScriptBlock {                              ",
      "  param($NewPath, $OldPath)                                                           ",
      "  zoxide add '--' $NewPath                                                            ", 
      "}                                                                                     ",
      "                                                                                      ",
      "# Export-ModuleMember -Function * -alias *                                            "
    ]
  }
}
