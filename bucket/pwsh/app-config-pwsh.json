{
  "version": "1.0",
  "description": "App config",
  "note" : "",
  "homepage": "https://github.com/owenstake/owen-bucket",
  "depends": [],
  "url": "https://github.com/owenstake/owen-bucket/releases/download/v1.0.0/Empty.txt",
  "hash": "2E1CFA82B035C26CBBBDAE632CEA070514EB8B773F616AAEAF668E2F0BE8F10D",
  "psmodule": { "name": "default" },
  "pre_install" : [
    "''                                                         ",
    "if ($null -ne $manifest.files) {                           ",
    "  foreach ($prop in $manifest.files.psobject.Properties) { ",
    "    if ($prop.Name -like 'default.*') {                    ",
    "      $filename = $prop.Name -replace 'default',$app       ",
    "    } else {                                               ",
    "      $filename = $prop.Name                               ", 
    "    }                                                      ",
    "    $fullpath = Join-Path $dir $filename                   ",
    "    info ('Writing to ' + $fullpath)                       ",
    "    $prop.Value = $prop.Value -replace '(?m)\\s+$', ''     ",
    "    Set-Content -Path $fullpath -Value $prop.value         ",
    "  }                                                        ",
    "}                                                          "
  ],
  "installer": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') {       ",
      "  $manifest.psmodule.name = $app                   ",
      "}                                                  "
    ]
  },
  "uninstaller": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') {       ",
      "  $manifest.psmodule.name = $app                   ",
      "}                                                  "
    ]
  },
  "files" : {
    "default.psm1" : [
      "# tmux                                                               ",
      "Function ta  { tmux attach @args       }                             ",
      "Function tn  { tmux new @args          }                             ",
      "Function tls { tmux list-sessions @args}                             ",
      "Function tk  { tmux kill-session @args }                             ",
      "Function tp  { tmuxpanel @args         }                             ",
      "                                                                     ",
      "# vim                                                                ",
      "Function vic { vim ~/_vimrc }                                        ",
      "                                                                     ",
      "## git function                                                      ",
      "del alias:gc  -errorAction silentlyContinue                          ",
      "del alias:glg -errorAction silentlyContinue                          ",
      "set-alias gst invoke-gst                                             ",
      "Function ga   {git add                  @args}                       ",
      "Function gd   {git diff --color @args | bat --style plain }          ",
      "Function invoke-gst  {git status               @args}                ",
      "Function gc   {git commit               @args}                       ",
      "Function gca  {git commit -v -a         @args}                       ",
      "Function glg  {git log --stat           @args}                       ",
      "Function grbi {git rebase --interactive @args}                       ",
      "                                                                     ",
      "Function trash-restore {                                             ",
      "  $lines = $(trash list --rev | fzf --multi --reverse )              ",
      "  if($lines) {                                                       ",
      "    $files = @()                                                     ",
      "    foreach ($l in $lines ) {                                        ",
      "      $files += ($l -split '\\s+')[-2]                               ",
      "    }                                                                ",
      "    if($file) {                                                      ",
      "      trash restore --match=exact $files                             ",
      "    }                                                                ",
      "  }                                                                  ",
      "}                                                                    ",
      "                                                                     ",
      "# typora                                                             ",
      "Function ty($pathName='.') {                                         ",
      "  $pathName = $pathName.Trim([char]34)    # 34 is double quote       ",
      "  If ( !(Test-Path $pathName )) {                                    ",
      "    throw [System.IO.FileNotFoundException] ($pathName + 'not found')",
      "  }                                                                  ",
      "  return typora.exe $pathName                                        ",
      "}                                                                    ",
      "                                                                     ",
      "# draw.io                                                            ",
      "Function da($pathName='.') {                                         ",
      "  $pathName = $pathName.Trim([char]34)    # 34 is double quote       ",
      "  If ( !(Test-Path $pathName )) {                                    ",
      "    throw [System.IO.FileNotFoundException] ($pathName + 'not found')",
      "  }                                                                  ",
      "  Start-Process -NoNewWindow draw.io.exe $pathName                   ",
      "  return                                                             ",
      "}                                                                    ",
      "                                                                     "
    ]
  }
}
