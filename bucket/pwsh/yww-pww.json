{
  "version": "1.0",
  "description": "Config Explorer View",
  "homepage": "https://github.com/owenstake/owen-bucket",
  "depends": [],
  "url": "https://github.com/owenstake/owen-bucket/releases/download/v1.0.0/Empty.txt",
  "hash": "2E1CFA82B035C26CBBBDAE632CEA070514EB8B773F616AAEAF668E2F0BE8F10D",
  "psmodule": {
    "name": "default"
  },
  "pre_install" : [
    "''                                                         ",
    "if ($null -ne $manifest.files) {                           ",
    "  foreach ($prop in $manifest.files.psobject.Properties) { ",
    "    if ($prop.Name -like 'default.*') {                    ",
    "      $filename = $prop.Name -replace 'default',$app       ",
    "    } else {                                               ",
    "      $filename = $prop.Name                               ", 
    "    }                                                      ",
    "    $fullpath = Join-Path $dir $filename                   ",
    "    info ('Writing to ' + $fullpath)                       ",
    "    $prop.Value = $prop.Value -replace '(?m)\\s+$', ''     ",
    "    Set-Content -Path $fullpath -Value $prop.value         ",
    "  }                                                        ",
    "}                                                          "
  ],
  "installer": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') {   ",
      "  $manifest.psmodule.name = $app               ",
      "}                                              "
    ]
  },
  "uninstaller": {
    "script": [
      "if ($manifest.psmodule.name -eq 'default') {       ",
      "  $manifest.psmodule.name = $app                   ",
      "}                                                  "
    ]
  },
  "files" : {
    "default.psm1" : [
      "Add-Type -AssemblyName System.Windows.Forms    # Introduce .net clipboard               ",
      "set-alias yww Copy-File                                                                 ",
      "set-alias pww Paste-File                                                                ",
      "set-alias pss Paste-FileAsShortcut                                                      ",
      "set-alias pll List-FileInClipboard                                                      ",
      "                                                                                        ",
      "function Copy-File() {                                                                  ",
      "  # 1. 优先检测是否有管道文本流输入                                                     ",
      "  if ($MyInvocation.ExpectingInput) {                                                   ",
      "    # 将管道流转换为字符串                                                              ",
      "    $pipeContent = $input | Out-String                                                  ",
      "                                                                                        ",
      "    # 去除末尾可能产生的多余换行，并判断是否为空                                        ",
      "    if ($pipeContent.Trim()) {                                                          ",
      "      Set-Clipboard -Value $pipeContent.TrimEnd()                                       ",
      "      Write-Host '✅ 成功将管道文本流复制到剪贴板' -F Green                             ",
      "      return                                                                            ",
      "    }                                                                                   ",
      "  }                                                                                     ",
      "                                                                                        ",
      "  # 2. 如果没有管道输入，则处理文件路径参数                                             ",
      "  $files = new-object System.Collections.Specialized.StringCollection                   ",
      "  # get files from args                                                                 ",
      "  Foreach ($arg in $args) {                                                             ",
      "    Foreach ($pathName in $(Get-Item -Path $arg)) {  # path maybe wildcard like *png    ",
      "      [void]$files.Add($pathName)                                                       ",
      "    }                                                                                   ",
      "  }                                                                                     ",
      "                                                                                        ",
      "  If (!$files) {                                                                        ",
      "    Write-Warning 'PSH: Nothing Copied'                                                 ",
      "    return                                                                              ",
      "  }                                                                                     ",
      "                                                                                        ",
      "  # add files to clipboard                                                              ",
      "  If (-not [System.Windows.Forms.Clipboard]::SetFileDropList($files)) {                 ",
      "    $count = $files.count                                                               ",
      "    Write-Host ('PSH: Copy {0} items to clipboard' -f $count)                           ",
      "    Foreach ($file in $files)                                                           ",
      "    {                                                                                   ",
      "      Write-Host ('PSH:   {0}' -f $File)                                                ",
      "    }                                                                                   ",
      "  } else {                                                                              ",
      "    Write-Warning 'PSH: Fail Set-FileDropList'                                          ",
      "  }                                                                                     ",
      "  return                                                                                ",
      "}                                                                                       ",
      "                                                                                        ",
      "Function Paste-File($DesDirPath, $ImageName)                                            ",
      "{                                                                                       ",
      "  # default args value do not take effect because of @args                              ",
      "  If ($args[0]) {                                                                       ",
      "    $DesDirPath = $args[0]                                                              ",
      "  } else {                                                                              ",
      "    $DesDirPath = '.'                                                                   ",
      "  }                                                                                     ",
      "                                                                                        ",
      "  If ($args[1]) {                                                                       ",
      "    $ImageName = $args[1]                                                               ",
      "  } else {                                                                              ",
      "    $ImageName = 'screenshot-{0:yyyyMMdd-HHmmss}.png' -f (Get-Date)                     ",
      "  }                                                                                     ",
      "                                                                                        ",
      "  If ([System.Windows.Forms.Clipboard]::ContainsImage()) {                              ",
      "    $img = get-clipboard -format image                                                  ",
      "    $fullname = $(Get-Item ${DesDirPath}).FullName                                      ",
      "    $imgPath = Join-Path $fullname $ImageName                                           ",
      "    $img.save($imgPath)                                                                 ",
      "    Write-Host 'Psh: Image in clipboard and saved as {0}/{1}' -f $DesDirPath,$ImageName ",
      "  } ElseIf ([System.Windows.Forms.Clipboard]::ContainsFileDropList()) {                 ",
      "    $fileDropList = [System.Windows.Forms.Clipboard]::GetFileDropList()                 ",
      "    $cnt = $fileDropList.count                                                          ",
      "    Write-Host ('Psh: Psh copy clipboard {0} Items to DesDir ' -f $cnt)                 ",
      "    Write-Host 'Psh: Destination Directory: '                                           ",
      "    Write-Host ('Psh:     ' + $DesDirPath)                                              ",
      "    Write-Host 'Psh: Items: '                                                           ",
      "                                                                                        ",
      "    Foreach ($file in $fileDropList) {                                                  ",
      "      $desPath = Join-Path $DesDirPath $((Get-Item -Path $file).Name)                   ",
      "      Write-Host ('Psh:    {0} => {1}' -f $file,$desPath)                               ",
      "      Copy-Item -Recurse -Path $file -Destination (Get-Item -Path $DesDirPath).FullName ",
      "    }                                                                                   ",
      "  } Else {                                                                              ",
      "    Write-Warning 'Psh: No appendable content was found.'                               ",
      "  }                                                                                     ",
      "  return                                                                                ",
      "}                                                                                       ",
      "                                                                                        ",
      "function List-FileInClipboard {                                                         ",
      "  $files = new-object System.Collections.Specialized.StringCollection                   ",
      "                                                                                        ",
      "  # get files from clipboard                                                            ",
      "  if ([System.Windows.Forms.Clipboard]::ContainsFileDropList()) {                       ",
      "    $fileDropList = [System.Windows.Forms.Clipboard]::GetFileDropList()                 ",
      "    foreach ($file in $fileDropList) {                                                  ",
      "      [void]$files.Add((Get-Item -Path $file).FullName)                                 ",
      "    }                                                                                   ",
      "  }                                                                                     ",
      "  return $files                                                                         ",
      "}                                                                                       ",
      "                                                                                        ",
      "Function Create-ShortcutForFile($srcFilePath, $DesDirPath) {                            ",
      "  # auto replace path as env variable                                                   ",
      "  If (-Not (Test-Path $DesDirPath)) {                                                   ",
      "    Write-Warning ($DesDirPath + ' do not exist!')                                      ",
      "    return -1                                                                           ",
      "  }                                                                                     ",
      "  If (-Not (Test-Path $srcFilePath)) {                                                  ",
      "    Write-Warning ($srcFilePath + ' do not exist!')                                     ",
      "    return -1                                                                           ",
      "  }                                                                                     ",
      "  # check weiyun exists first                                                           ",
      "  If (-Not (Test-Path 'Env:weiyun')) {                                                  ",
      "    Write-Warning 'Env weiyun do not exist!'                                            ",
      "    return -1                                                                           ",
      "  }                                                                                     ",
      "                                                                                        ",
      "  $DesDirPath = (Get-Item $DesDirPath).FullName                                         ",
      "  $srcFilePath = (Get-Item $srcFilePath).FullName                                       ",
      "  $fileName = (Get-Item $srcFilePath).name                                              ",
      "                                                                                        ",
      "  $envNames = @('weiyun','oweninstalldir')                                              ",
      "                                                                                        ",
      "  $matchedEnvName = ''                                                                  ",
      "  Foreach ($en in $envNames) {                                                          ",
      "    $v = (Get-Item -Path ('Env:' + $en)).value                                          ",
      "    if ($srcFilePath.StartsWith($v, 'CurrentCultureIgnoreCase')) {                      ",
      "      $matchedEnvName = $en                                                             ",
      "      break                                                                             ",
      "    }                                                                                   ",
      "  }                                                                                     ",
      "  if ($matchedEnvName -ne '') {                                                         ",
      "    Write-Host ('matched' + $matchedEnvName)                                            ",
      "    $v = (Get-Item -Path 'env:$matchedEnvName').value                                   ",
      "    $curLocation = Get-Location     # save location                                     ",
      "    Set-Location $v                                                                     ",
      "    $relativeFilePath = Resolve-Path -Relative -Path $srcFilePath                       ",
      "    Set-Location $curLocation  # restore location                                       ",
      "    # skip first char '.'                                                               ",
      "    $filePathWithEnv = '%' + $matchedEnvName + '%' + $relativeFilePath.substring(1)     ",
      "  } else {                                                                              ",
      "    Write-verbose 'Env matched nothing'                                                 ",
      "    $filePathWithEnv = $srcFilePath                                                     ",
      "  }                                                                                     ",
      "                                                                                        ",
      "  $WshShell = New-Object -comObject WScript.Shell                                       ",
      "  $Shortcut = $WshShell.CreateShortcut($DesDirPath + '/' + $fileName + '.lnk')          ",
      "  $Shortcut.TargetPath = 'Explorer.exe'                                                 ",
      "  $Shortcut.Arguments  = $filePathWithEnv                                               ",
      "  $Shortcut.Save()                                                                      ",
      "  return                                                                                ",
      "}                                                                                       ",
      "                                                                                        ",
      "Function Paste-FileAsRelativeShortcut($DesDirPath, $filePath) {                         ",
      "  $fileName = (Get-Item $filePath).name                                                 ",
      "  $curLocation = Get-Location                                                           ",
      "  Set-Location $DesDirPath   # save location                                            ",
      "  $relativeFilePath = Resolve-Path -Relative -Path $filePath                            ",
      "  Set-Location $curLocation  # restore location                                         ",
      "                                                                                        ",
      "  $WshShell = New-Object -comObject WScript.Shell                                       ",
      "  $Shortcut = $WshShell.CreateShortcut($DesDirPath + '/' + $fileName + '.lnk')          ",
      "  $Shortcut.TargetPath = 'C:/windows/Explorer.exe'                                      ",
      "  $Shortcut.Arguments  = $relativeFilePath                                              ",
      "  $Shortcut.Save()                                                                      ",
      "}                                                                                       ",
      "                                                                                        ",
      "Function Paste-FileAsShortcut($DesDirPath) {                                            ",
      "  # default args value do not take effect because of @args                              ",
      "  If ($args[0]) {                                                                       ",
      "    $DesDirPath = $args[0]                                                              ",
      "  } else {                                                                              ",
      "    $DesDirPath = '.'                                                                   ",
      "  }                                                                                     ",
      "                                                                                        ",
      "  If ([System.Windows.Forms.Clipboard]::ContainsFileDropList()) {                       ",
      "    $fileDropList = [System.Windows.Forms.Clipboard]::GetFileDropList()                 ",
      "    $cnt = $fileDropList.count                                                          ",
      "    Write-Host ('Psh: Psh copy clipboard {0} Items to DesDir ' -f $cnt)                 ",
      "    Write-Host 'Psh: Destination Directory: '                                           ",
      "    Write-Host ('Psh:    ' + $DesDirPath)                                               ",
      "    Write-Host 'Psh: Items: '                                                           ",
      "                                                                                        ",
      "    Foreach ($file in $fileDropList) {                                                  ",
      "      $filename = (Get-Item -Path $file).Name                                           ",
      "      Write-Host ('Psh:     {0} => {1}/{2}' -f $file,$DesDirPath,$filename)             ",
      "      $params = @($(Get-Item -Path $file).FullName                                      ",
      "                  $(Get-Item -Path $DesDirPath).FullName)                               ",
      "      Create-ShortcutForFile @params                                                    ",
      "    }                                                                                   ",
      "  } Else {                                                                              ",
      "    Write-Warning 'Psh: No appendable content was found.'                               ",
      "  }                                                                                     ",
      "  return                                                                                ",
      "}                                                                                       ",
      "                                                                                        ",
      "Export-ModuleMember -alias * -Function *                                                "
    ]
  }
}
